@@ -0,0 +1,124 @@
+"""Helpers for reloading latent weights into an EdgeRazor vLLM model."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch
+from vllm.model_executor.utils import set_weight_attrs
+
+
+_PACKED_PARAMETERS = (
+    "qweight",
+    "qweight_scale",
+    "qweight_int4",
+    "qweight_int2",
+    "qweight_scale_int4",
+    "qweight_scale_int2",
+)
+_PACKED_BUFFERS = ("_edgerazor_inverse_perm",)
+
+
+def cache_weight_metadata(
+    layer: torch.nn.Module,
+    weight: torch.nn.Parameter,
+    weight_loader: Any,
+    extra_weight_attrs: dict[str, Any],
+) -> None:
+    """Remember enough metadata to recreate vLLM's raw HF weight parameter."""
+    layer._edgerazor_weight_meta = {
+        "shape": tuple(weight.shape),
+        "dtype": weight.dtype,
+        "input_dim": getattr(weight, "input_dim", 1),
+        "output_dim": getattr(weight, "output_dim", 0),
+        "weight_loader": weight_loader,
+        "extra_weight_attrs": dict(extra_weight_attrs),
+    }
+
+
+def _delete_tensor(layer: torch.nn.Module, name: str) -> None:
+    if name in layer._parameters or name in layer._buffers:
+        delattr(layer, name)
+
+
+def _retie_lm_head(model: torch.nn.Module, prepared: set[int]) -> bool:
+    """Re-share the embedding parameter with a tied lm_head.
+
+    vLLM's llama.py keeps lm_head as its own module that merely shares the
+    embedding's weight tensor, then tells the loader to skip "lm_head." because
+    the two are tied. Rebuilding each layer's raw parameter independently severs
+    that sharing, so lm_head keeps the uninitialized tensor forever and the model
+    emits uniform-random logits. qwen3.py aliases the whole module instead, which
+    is why only Llama-shaped models hit this.
+    """
+    from vllm.model_executor.layers.vocab_parallel_embedding import (
+        VocabParallelEmbedding,
+    )
+
+    if not getattr(getattr(model, "config", None), "tie_word_embeddings", False):
+        return False
+    lm_head = getattr(model, "lm_head", None)
+    if lm_head is None or id(lm_head) not in prepared:
+        return False
+    # ParallelLMHead subclasses VocabParallelEmbedding, so an exact type match
+    # picks out the input embedding and never the head itself.
+    embeds = [m for m in model.modules()
+              if type(m) is VocabParallelEmbedding and id(m) in prepared]
+    if len(embeds) != 1:
+        return False
+    embed = embeds[0]
+    if lm_head is embed or lm_head.weight.shape != embed.weight.shape:
+        return False
+    lm_head.register_parameter("weight", embed.weight)
+    return True
+
+
+def prepare_for_weight_reload(model: torch.nn.Module, device=None) -> int:
+    """Replace packed tensors with raw parameters accepted by model.load_weights."""
+    from vllm.model_executor.parameter import ModelWeightParameter
+
+    prepared = 0
+    prepared_ids: set[int] = set()
+    for layer in model.modules():
+        meta = getattr(layer, "_edgerazor_weight_meta", None)
+        if meta is None:
+            continue
+
+        for name in _PACKED_PARAMETERS:
+            _delete_tensor(layer, name)
+        for name in _PACKED_BUFFERS:
+            _delete_tensor(layer, name)
+        _delete_tensor(layer, "weight")
+
+        target_device = device
+        if target_device is None:
+            target_device = next(layer.parameters(), torch.empty(0)).device
+        data = torch.empty(meta["shape"], dtype=meta["dtype"], device=target_device)
+        weight = ModelWeightParameter(
+            data=data,
+            input_dim=meta["input_dim"],
+            output_dim=meta["output_dim"],
+            weight_loader=meta["weight_loader"],
+        )
+        layer.register_parameter("weight", weight)
+        set_weight_attrs(weight, meta["extra_weight_attrs"])
+        layer._edgerazor_needs_pack = True
+        prepared_ids.add(id(layer))
+        prepared += 1
+
+    _retie_lm_head(model, prepared_ids)
+    return prepared
+
+
+def process_weights_after_loading(model: torch.nn.Module) -> int:
+    """Pack every reloaded EdgeRazor layer after all weight buckets arrive."""
+    processed = 0
+    for layer in model.modules():
+        if not getattr(layer, "_edgerazor_needs_pack", False):
+            continue
+        quant_method = getattr(layer, "quant_method", None)
+        if quant_method is None or not hasattr(quant_method, "process_weights_after_loading"):
+            continue
+        quant_method.process_weights_after_loading(layer)
+        processed += 1
+    return processed
