+"""Regression coverage for KV quantization during Transformers generation."""
+
+from types import SimpleNamespace
+
+import torch
+from transformers import Qwen3Config, Qwen3ForCausalLM
+from transformers.cache_utils import DynamicCache
+
+from edgerazor.qat.block.qkv_cache import QuantizedKVState
+from edgerazor.templates.modeling_edgerazor import _inject_kv_cache
+
+
+def test_qwen3_generate_wraps_preallocated_dynamic_cache():
+    config = Qwen3Config(
+        vocab_size=128,
+        hidden_size=64,
+        intermediate_size=128,
+        num_hidden_layers=2,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=16,
+        max_position_embeddings=128,
+        pad_token_id=0,
+        eos_token_id=None,
+    )
+    model = Qwen3ForCausalLM(config).eval()
+    quant_calls = 0
+
+    def quant_fn(x, **kwargs):
+        nonlocal quant_calls
+        quant_calls += 1
+        scale = x.detach().abs().amax(dim=-1, keepdim=True).clamp_min(1e-5) / 127
+        return (x / scale).round().clamp(-127, 127) * scale
+
+    class FakeEdgeRazor:
+        is_qat_enabled = True
+        qat = SimpleNamespace(selector=SimpleNamespace(has_kv_cache=True))
+
+        @staticmethod
+        def create_kv_cache(model_config=None, cache=None):
+            if cache is None:
+                cache = DynamicCache(config=model_config)
+            return QuantizedKVState(cache, quant_fn, {})
+
+    _inject_kv_cache(model, FakeEdgeRazor())
+
+    with torch.inference_mode():
+        output = model.generate(
+            torch.tensor([[1, 4, 7]]),
+            max_new_tokens=4,
+            do_sample=False,
+        )
+
+    assert output.shape == (1, 7)
+    assert quant_calls >= 2 * config.num_hidden_layers
