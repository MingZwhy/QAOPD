@@ -0,0 +1,52 @@
+from types import SimpleNamespace
+
+import torch
+
+from edgerazor.vllm.dynamic_reload import (
+    prepare_for_weight_reload,
+    process_weights_after_loading,
+)
+from edgerazor.vllm.linear_py import EdgeRazorPyMixedPrecisionLinearMethod
+
+
+def test_mixed_precision_layer_can_reload_and_repack(monkeypatch):
+    monkeypatch.setattr("vllm.model_executor.parameter.get_tensor_model_parallel_rank", lambda: 0)
+    monkeypatch.setattr("vllm.model_executor.parameter.get_tensor_model_parallel_world_size", lambda: 1)
+    config = SimpleNamespace(
+        _quant_block_size=256,
+        _scale_block_size=32,
+        activation_bits=8,
+        weight_bits=2.79,
+    )
+    method = EdgeRazorPyMixedPrecisionLinearMethod(config)
+    layer = torch.nn.Module()
+    layer.quant_method = method
+
+    def weight_loader(param, loaded_weight, *args, **kwargs):
+        param.data.copy_(loaded_weight)
+
+    method.create_weights(
+        layer,
+        input_size_per_partition=256,
+        output_partition_sizes=[64],
+        input_size=256,
+        output_size=64,
+        params_dtype=torch.bfloat16,
+        weight_loader=weight_loader,
+    )
+    first_weight = torch.randn(64, 256, dtype=torch.bfloat16)
+    layer.weight.data.copy_(first_weight)
+    method.process_weights_after_loading(layer)
+
+    assert not hasattr(layer, "weight")
+    assert hasattr(layer, "qweight_int4")
+    assert prepare_for_weight_reload(layer, device=torch.device("cpu")) == 1
+    assert layer.weight.shape == first_weight.shape
+    assert not hasattr(layer, "qweight_int4")
+
+    second_weight = torch.randn_like(first_weight)
+    layer.weight.data.copy_(second_weight)
+    assert process_weights_after_loading(layer) == 1
+    assert not hasattr(layer, "weight")
+    assert hasattr(layer, "qweight_int4")
+    assert hasattr(layer, "_edgerazor_inverse_perm")
