+import json
+
+import pytest
+import torch
+from safetensors.torch import load_file, save_file
+
+from examples.on_policy_distillation_trainer.merge_hf_task_vector_consensus import (
+    merge_checkpoints,
+    normalized_task_vector_consensus,
+)
+
+
+def test_normalized_task_vector_consensus_matches_target_norm():
+    anchor = {"weight": torch.tensor([0.0, 0.0])}
+    endpoints = [
+        {"weight": torch.tensor([2.0, 0.0])},
+        {"weight": torch.tensor([0.0, 4.0])},
+    ]
+
+    merged, diagnostics = normalized_task_vector_consensus(anchor, endpoints, target_norm_index=0)
+
+    expected = torch.tensor([2.0**0.5, 2.0**0.5])
+    torch.testing.assert_close(merged["weight"], expected)
+    assert diagnostics["endpoint_norms"] == [2.0, 4.0]
+    assert diagnostics["pairwise_cosines"]["0:1"] == 0.0
+    assert torch.linalg.vector_norm(merged["weight"]).item() == pytest.approx(2.0)
+
+
+def test_normalized_task_vector_consensus_rejects_zero_or_incompatible_endpoint():
+    anchor = {"weight": torch.tensor([0.0])}
+    with pytest.raises(ValueError, match="At least two"):
+        normalized_task_vector_consensus(anchor, [{"weight": torch.tensor([1.0])}])
+    with pytest.raises(ValueError, match="norms"):
+        normalized_task_vector_consensus(
+            anchor,
+            [{"weight": torch.tensor([0.0])}, {"weight": torch.tensor([1.0])}],
+        )
+    with pytest.raises(ValueError, match="metadata differs"):
+        normalized_task_vector_consensus(
+            anchor,
+            [{"weight": torch.tensor([[1.0]])}, {"weight": torch.tensor([1.0])}],
+        )
+
+
+def test_normalized_task_vector_consensus_promotes_floating_anchor_to_endpoint_dtype():
+    anchor = {"weight": torch.tensor([0.0, 0.0], dtype=torch.bfloat16)}
+    endpoints = [
+        {"weight": torch.tensor([2.0, 0.0], dtype=torch.float32)},
+        {"weight": torch.tensor([0.0, 4.0], dtype=torch.float32)},
+    ]
+
+    merged, diagnostics = normalized_task_vector_consensus(anchor, endpoints)
+
+    assert merged["weight"].dtype == torch.float32
+    assert diagnostics["floating_output_dtype"] == "torch.float32"
+
+
+def test_merge_checkpoints_copies_anchor_metadata_and_writes_manifest(tmp_path):
+    anchor = tmp_path / "anchor"
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    output = tmp_path / "output"
+    for path in (anchor, first, second):
+        path.mkdir()
+    save_file({"weight": torch.tensor([0.0, 0.0])}, anchor / "model.safetensors", metadata={"format": "pt"})
+    save_file({"weight": torch.tensor([2.0, 0.0])}, first / "model.safetensors")
+    save_file({"weight": torch.tensor([0.0, 4.0])}, second / "model.safetensors")
+    (anchor / "config.json").write_text('{"model_type":"test"}\n', encoding="utf-8")
+
+    manifest = merge_checkpoints(anchor, [first, second], output)
+
+    merged = load_file(output / "model.safetensors")["weight"]
+    torch.testing.assert_close(merged, torch.tensor([2.0**0.5, 2.0**0.5]))
+    assert json.loads((output / "config.json").read_text())["model_type"] == "test"
+    assert json.loads((output / "task_vector_consensus.json").read_text()) == manifest
