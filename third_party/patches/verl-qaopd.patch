@@ -0,0 +1,117 @@
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from verl.experimental.agent_loop.teacher_forcing_agent_loop import (
+    PreferenceTeacherForcingAgentLoop,
+    tokenize_reference_trajectory,
+)
+
+
+class FakeTokenizer:
+    def apply_chat_template(self, messages, *, add_generation_prompt, tokenize, **kwargs):
+        assert kwargs == {"enable_thinking": True}
+        prompt = "prompt"
+        if add_generation_prompt:
+            return [10, 11, 12] if tokenize else prompt
+        assert messages[-1] == {"role": "assistant", "content": "#### 5"}
+        assert tokenize is False
+        return prompt + "response"
+
+    def encode(self, text, *, add_special_tokens):
+        assert text == "response"
+        assert add_special_tokens is False
+        return [20, 21, 2]
+
+    def decode(self, token_ids, *, skip_special_tokens, clean_up_tokenization_spaces):
+        assert skip_special_tokens is False
+        assert clean_up_tokenization_spaces is False
+        mapping = {
+            (20, 21, 2): "response",
+            (30, 31): "response",
+            (40, 41): "response",
+            (30, 32): "different",
+        }
+        return mapping[tuple(token_ids)]
+
+
+def test_tokenize_reference_trajectory_splits_at_generation_prompt():
+    messages = [{"role": "user", "content": "What is 2 + 3?"}]
+    prompt_ids, response_ids = tokenize_reference_trajectory(
+        FakeTokenizer(), messages, "#### 5", {"enable_thinking": True}
+    )
+
+    assert prompt_ids == [10, 11, 12]
+    assert response_ids == [20, 21, 2]
+
+
+def test_tokenize_reference_trajectory_preserves_equivalent_pretokenized_response():
+    messages = [{"role": "user", "content": "What is 2 + 3?"}]
+
+    prompt_ids, response_ids = tokenize_reference_trajectory(
+        FakeTokenizer(),
+        messages,
+        "#### 5",
+        {"enable_thinking": True},
+        response_token_ids=[30, 31],
+    )
+
+    assert prompt_ids == [10, 11, 12]
+    assert response_ids == [30, 31]
+
+
+def test_tokenize_reference_trajectory_rejects_pretokenized_text_mismatch():
+    messages = [{"role": "user", "content": "What is 2 + 3?"}]
+
+    try:
+        tokenize_reference_trajectory(
+            FakeTokenizer(),
+            messages,
+            "#### 5",
+            {"enable_thinking": True},
+            response_token_ids=[30, 32],
+        )
+    except ValueError as exc:
+        assert "does not decode" in str(exc)
+    else:
+        raise AssertionError("mismatched pre-tokenized response was accepted")
+
+
+@pytest.mark.parametrize(
+    ("session_id", "expected_ids", "expected_role"),
+    [(0, [30, 31], "chosen"), (1, [40, 41], "rejected")],
+)
+def test_preference_teacher_forcing_agent_selects_session_role(session_id, expected_ids, expected_role):
+    agent = object.__new__(PreferenceTeacherForcingAgentLoop)
+    agent.tokenizer = FakeTokenizer()
+    agent.apply_chat_template_kwargs = {"enable_thinking": True}
+    agent.rollout_config = SimpleNamespace(response_length=8)
+    agent.loop = asyncio.new_event_loop()
+    agent._cap_text_prompt_length = lambda ids: ids
+    try:
+        output = agent.loop.run_until_complete(
+            agent.run(
+                {},
+                session_id=session_id,
+                raw_prompt=[{"role": "user", "content": "What is 2 + 3?"}],
+                extra_info={
+                    "chosen_answer": "#### 5",
+                    "rejected_answer": "#### 5",
+                    "chosen_response_token_ids": [30, 31],
+                    "rejected_response_token_ids": [40, 41],
+                },
+                global_steps=3,
+            )
+        )
+    finally:
+        agent.loop.close()
+
+    assert output.response_ids == expected_ids
+    assert output.extra_fields["preference_role"] == expected_role
+
+
+def test_preference_teacher_forcing_agent_rejects_extra_session():
+    agent = object.__new__(PreferenceTeacherForcingAgentLoop)
+    with pytest.raises(ValueError, match="session_id 0 or 1"):
+        asyncio.run(agent.run({}, session_id=2))
