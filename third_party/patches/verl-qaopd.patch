+import json
+
+import pytest
+import torch
+from safetensors.torch import load_file, save_file
+
+from examples.on_policy_distillation_trainer.interpolate_hf_checkpoints import (
+    interpolate_checkpoints,
+    interpolate_state_dicts,
+)
+
+
+def test_interpolate_state_dicts_uses_anchor_to_endpoint_formula():
+    anchor = {"weight": torch.tensor([0.0, 2.0], dtype=torch.bfloat16)}
+    endpoint = {"weight": torch.tensor([4.0, 6.0], dtype=torch.bfloat16)}
+
+    result = interpolate_state_dicts(anchor, endpoint, 0.25)
+
+    torch.testing.assert_close(result["weight"], torch.tensor([1.0, 3.0], dtype=torch.bfloat16))
+
+
+def test_interpolate_state_dicts_rejects_incompatible_inputs():
+    with pytest.raises(ValueError, match="alpha"):
+        interpolate_state_dicts({"x": torch.ones(1)}, {"x": torch.ones(1)}, 1.1)
+    with pytest.raises(ValueError, match="keys differ"):
+        interpolate_state_dicts({"x": torch.ones(1)}, {"y": torch.ones(1)}, 0.5)
+
+
+def test_interpolate_state_dicts_can_cast_floating_endpoint_dtype_explicitly():
+    anchor = {"weight": torch.tensor([0.0, 2.0], dtype=torch.float32)}
+    endpoint = {"weight": torch.tensor([4.0, 6.0], dtype=torch.bfloat16)}
+
+    with pytest.raises(ValueError, match="Tensor metadata differs"):
+        interpolate_state_dicts(anchor, endpoint, 0.25)
+
+    result = interpolate_state_dicts(anchor, endpoint, 0.25, allow_endpoint_dtype_cast=True)
+
+    assert result["weight"].dtype == torch.float32
+    torch.testing.assert_close(result["weight"], torch.tensor([1.0, 3.0]))
+
+
+def test_interpolate_checkpoints_copies_metadata_and_writes_manifest(tmp_path):
+    anchor = tmp_path / "anchor"
+    endpoint = tmp_path / "endpoint"
+    output = tmp_path / "output"
+    anchor.mkdir()
+    endpoint.mkdir()
+    save_file({"weight": torch.tensor([0.0])}, anchor / "model.safetensors", metadata={"format": "pt"})
+    save_file({"weight": torch.tensor([2.0])}, endpoint / "model.safetensors")
+    (anchor / "config.json").write_text('{"model_type":"test"}\n', encoding="utf-8")
+
+    manifest = interpolate_checkpoints(anchor, endpoint, output, 0.25)
+
+    torch.testing.assert_close(load_file(output / "model.safetensors")["weight"], torch.tensor([0.5]))
+    assert json.loads((output / "config.json").read_text())["model_type"] == "test"
+    assert json.loads((output / "interpolation.json").read_text()) == manifest
