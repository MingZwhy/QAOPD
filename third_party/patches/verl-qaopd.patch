+import json
+
+import pytest
+
+from examples.on_policy_distillation_trainer.prepare_code_quantization_regression import (
+    MIN_TRAIN_ROWS,
+    MIN_VALIDATION_ROWS,
+    build_tiers,
+    choose_tier,
+    ground_truth_key,
+    load_scan,
+    normalize_pool_schema,
+)
+
+
+def _source(task_id: int, split: str = "train") -> dict:
+    ground_truth = {
+        "function_stub": f"def fn_{task_id}():\n",
+        "function_name": f"fn_{task_id}",
+        "tests": [f"assert fn_{task_id}() == {task_id}"],
+    }
+    return {
+        "task_id": task_id,
+        "reward_model": {"ground_truth": json.dumps(ground_truth)},
+        "extra_info": {
+            "task_id": task_id,
+            "frontier_source": "synthetic",
+            "split": split,
+        },
+    }
+
+
+def _scan_rows(source: dict, successes: int, total: int = 8) -> list[dict]:
+    ground_truth = source["reward_model"]["ground_truth"]
+    return [
+        {
+            "input": f"prompt-{source['task_id']}",
+            "output": f"output-{index}",
+            "gts": ground_truth,
+            "score": float(index < successes),
+        }
+        for index in range(total)
+    ]
+
+
+def test_load_scan_and_build_nested_regression_tiers(tmp_path):
+    sources = [_source(1), _source(2, split="validation")]
+    fp_rows = _scan_rows(sources[0], 5) + _scan_rows(sources[1], 3)
+    qad_rows = _scan_rows(sources[0], 1) + _scan_rows(sources[1], 0)
+    fp_path = tmp_path / "fp.jsonl"
+    qad_path = tmp_path / "qad.jsonl"
+    fp_path.write_text("\n".join(json.dumps(row) for row in fp_rows) + "\n")
+    qad_path.write_text("\n".join(json.dumps(row) for row in qad_rows) + "\n")
+    expected = {
+        ground_truth_key(source["reward_model"]["ground_truth"]) for source in sources
+    }
+
+    fp = load_scan(fp_path, expected_keys=expected, samples_per_prompt=8)
+    qad = load_scan(qad_path, expected_keys=expected, samples_per_prompt=8)
+    tiers, diagnostics = build_tiers(
+        sources,
+        fp_stats=fp,
+        qad_stats=qad,
+        samples_per_prompt=8,
+    )
+
+    assert [row["task_id"] for row in tiers["core"]] == [1]
+    assert [row["task_id"] for row in tiers["strong"]] == [1, 2]
+    assert [row["task_id"] for row in tiers["directional"]] == [1, 2]
+    assert diagnostics[0]["success_margin"] == 4
+    assert tiers["core"][0]["extra_info"]["quant_reg_fp_successes"] == 5
+    assert tiers["core"][0]["extra_info"]["quant_reg_qad_successes"] == 1
+
+
+def test_load_scan_fails_closed_on_missing_samples(tmp_path):
+    source = _source(1)
+    path = tmp_path / "short.jsonl"
+    path.write_text("\n".join(json.dumps(row) for row in _scan_rows(source, 3, total=7)) + "\n")
+    expected = {ground_truth_key(source["reward_model"]["ground_truth"])}
+
+    with pytest.raises(ValueError, match="has 7 samples, expected 8"):
+        load_scan(path, expected_keys=expected, samples_per_prompt=8)
+
+
+def test_choose_tier_uses_strictest_tier_meeting_frozen_counts():
+    counts = {
+        "core": {"train": MIN_TRAIN_ROWS - 1, "validation": MIN_VALIDATION_ROWS},
+        "strong": {"train": MIN_TRAIN_ROWS, "validation": MIN_VALIDATION_ROWS},
+        "directional": {"train": MIN_TRAIN_ROWS + 10, "validation": MIN_VALIDATION_ROWS + 10},
+    }
+    assert choose_tier(counts) == "strong"
+
+
+def test_normalize_pool_schema_unifies_integer_and_string_source_ids():
+    rows = [
+        {"extra_info": {"source_task_id": 12}},
+        {"extra_info": {"source_task_id": "Leetcode_12_I"}},
+        {"extra_info": {"source_task_id": None}},
+    ]
+    normalize_pool_schema(rows)
+    assert [row["extra_info"]["source_task_id"] for row in rows] == [
+        "12",
+        "Leetcode_12_I",
+        None,
+    ]
