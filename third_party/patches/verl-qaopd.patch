+    calls = []
+
+    engine = SimpleNamespace(
+        _is_lora=False,
+        _qat_enabled=True,
+        engine_config=SimpleNamespace(forward_only=True),
+        rank=1,
+        _build_module=lambda: source,
+        _apply_qat=lambda module: calls.append(module) or quantized,
+        _build_fsdp_module=lambda module: module,
+    )
+    monkeypatch.setattr(torch.distributed, "barrier", lambda: None)
+    monkeypatch.setattr(transformer_impl, "log_gpu_memory_usage", lambda *args, **kwargs: None)
+
+    transformer_impl.FSDPEngine._build_model_optimizer(engine)
