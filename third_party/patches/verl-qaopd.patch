+#     http://www.apache.org/licenses/LICENSE-2.0
+
+from typing import Any
+
+from verl.experimental.agent_loop.agent_loop import (
+    AgentLoopBase,
+    AgentLoopMetrics,
+    AgentLoopOutput,
+    register,
+)
+from verl.utils.tokenizer import normalize_token_ids
+
+
+def tokenize_reference_trajectory(
+    tokenizer,
+    messages: list[dict],
+    answer: str,
+    chat_template_kwargs: dict,
+    response_token_ids=None,
+):
+    """Tokenize a fixed response, optionally preserving pre-generated token ids.
+
+    ``response_token_ids`` is useful when a teacher generated a valid token
+    sequence that is not the canonical BPE encoding under the student
+    tokenizer. The supplied ids are accepted only when they decode to exactly
+    the same response text as the dataset answer.
+    """
+    prompt_ids = normalize_token_ids(
+        tokenizer.apply_chat_template(
+            messages,
+            add_generation_prompt=True,
+            tokenize=True,
+            **chat_template_kwargs,
+        )
+    )
+    prompt_text = tokenizer.apply_chat_template(
+        messages,
+        add_generation_prompt=True,
+        tokenize=False,
+        **chat_template_kwargs,
+    )
+    full_text = tokenizer.apply_chat_template(
+        [*messages, {"role": "assistant", "content": answer}],
+        add_generation_prompt=False,
+        tokenize=False,
+        **chat_template_kwargs,
+    )
+    if not full_text.startswith(prompt_text):
+        raise ValueError("Reference response does not share the generation-prompt text prefix")
+
+    # Encode the suffix separately. BPE tokenization can merge the final prompt
+    # characters with the first response characters, even when the text prefix
+    # is exact; preserving prompt_ids keeps the training context equal to rollout.
+    response_ids = normalize_token_ids(tokenizer.encode(full_text[len(prompt_text) :], add_special_tokens=False))
+    if response_token_ids is not None:
+        supplied_response_ids = normalize_token_ids(response_token_ids)
+        if not supplied_response_ids:
+            raise ValueError("Pre-tokenized reference response is empty")
+        canonical_text = tokenizer.decode(
+            response_ids,
+            skip_special_tokens=False,
+            clean_up_tokenization_spaces=False,
+        )
+        supplied_text = tokenizer.decode(
+            supplied_response_ids,
+            skip_special_tokens=False,
+            clean_up_tokenization_spaces=False,
+        )
+        if supplied_text != canonical_text:
+            raise ValueError("Pre-tokenized reference response does not decode to the dataset answer")
+        response_ids = supplied_response_ids
+    return prompt_ids, response_ids
+
+
+@register("teacher_forcing_agent")
+class TeacherForcingAgentLoop(AgentLoopBase):
+    """Return the dataset reference solution instead of sampling from the student."""
+
+    async def run(self, sampling_params: dict[str, Any], **kwargs) -> AgentLoopOutput:
+        del sampling_params
+        messages = list(kwargs["raw_prompt"])
+        answer = str(kwargs["extra_info"]["answer"])
+        prompt_ids, response_ids = await self.loop.run_in_executor(
+            None,
+            tokenize_reference_trajectory,
+            self.tokenizer,
+            messages,
+            answer,
+            self.apply_chat_template_kwargs,
+            kwargs["extra_info"].get("response_token_ids"),
+        )
+
+        prompt_ids = self._cap_text_prompt_length(prompt_ids)
+        response_ids = response_ids[: self.rollout_config.response_length]
+        global_steps = int(kwargs.get("global_steps", -1))
+        return AgentLoopOutput(
+            prompt_ids=prompt_ids,
+            response_ids=response_ids,
+            response_mask=[1] * len(response_ids),
+            num_turns=2,
+            metrics=AgentLoopMetrics(),
+            extra_fields={
+                "turn_scores": [],
+                "tool_rewards": [],
+                "reference_trajectory": True,
+                "min_global_steps": global_steps,
+                "max_global_steps": global_steps,
+            },
+        )
+
+
+@register("preference_teacher_forcing_agent")
+class PreferenceTeacherForcingAgentLoop(AgentLoopBase):
+    """Return one chosen/rejected fixed response according to rollout session."""
+
+    async def run(self, sampling_params: dict[str, Any], **kwargs) -> AgentLoopOutput:
+        del sampling_params
+        session_id = int(kwargs["session_id"])
+        if session_id not in {0, 1}:
+            raise ValueError(f"preference_teacher_forcing_agent requires session_id 0 or 1, got {session_id}")
+        role = "chosen" if session_id == 0 else "rejected"
+        messages = list(kwargs["raw_prompt"])
+        extra_info = kwargs["extra_info"]
+        answer = str(extra_info[f"{role}_answer"])
+        prompt_ids, response_ids = await self.loop.run_in_executor(
+            None,
+            tokenize_reference_trajectory,
+            self.tokenizer,
+            messages,
+            answer,
+            self.apply_chat_template_kwargs,
+            extra_info.get(f"{role}_response_token_ids"),
+        )
+
+        prompt_ids = self._cap_text_prompt_length(prompt_ids)
+        response_ids = response_ids[: self.rollout_config.response_length]
+        global_steps = int(kwargs.get("global_steps", -1))
+        return AgentLoopOutput(
+            prompt_ids=prompt_ids,
+            response_ids=response_ids,
+            response_mask=[1] * len(response_ids),
+            num_turns=2,
+            metrics=AgentLoopMetrics(),
+            extra_fields={
+                "turn_scores": [],
+                "tool_rewards": [],
+                "reference_trajectory": True,
+                "preference_role": role,
+                "min_global_steps": global_steps,
+                "max_global_steps": global_steps,
+            },
+        )
