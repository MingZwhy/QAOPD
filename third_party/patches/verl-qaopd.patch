@@ -0,0 +1,135 @@
+import json
+
+import pytest
+
+from examples.on_policy_distillation_trainer.generate_verified_mbpp_teacher_trajectories import (
+    ASSISTANT_PREFIX_NO_THINK,
+    assemble_teacher_native_row,
+    select_best_verified_candidate,
+)
+
+
+class CharacterTokenizer:
+    def __init__(self, function_stub: str):
+        self.function_stub = function_stub
+
+    @staticmethod
+    def encode(text, *, add_special_tokens):
+        assert add_special_tokens is False
+        return [1000 + ord(character) for character in text]
+
+    @staticmethod
+    def decode(token_ids, *, skip_special_tokens, clean_up_tokenization_spaces):
+        assert skip_special_tokens is False
+        assert clean_up_tokenization_spaces is False
+        return "".join(chr(int(token_id) - 1000) for token_id in token_ids)
+
+    def apply_chat_template(self, messages, *, add_generation_prompt, tokenize, **kwargs):
+        assert kwargs == {"enable_thinking": False}
+        base = "PROMPT"
+        if add_generation_prompt:
+            text = base + ASSISTANT_PREFIX_NO_THINK + self.function_stub
+        else:
+            text = base + messages[-1]["content"] + "<END>"
+        return self.encode(text, add_special_tokens=False) if tokenize else text
+
+
+def _source() -> dict:
+    ground_truth = {
+        "function_stub": "def add_one(x):\n",
+        "function_name": "add_one",
+        "tests": ["assert add_one(2) == 3"],
+        "test_setup_code": "",
+    }
+    return {
+        "task_id": 1,
+        "data_source": "mbpp_humaneval",
+        "prompt": [{"role": "user", "content": "complete add_one"}],
+        "ability": "code",
+        "reward_model": {"style": "rule", "ground_truth": json.dumps(ground_truth)},
+        "extra_info": {"task_id": 1, "function_name": "add_one"},
+    }
+
+
+def _candidate(tokenizer: CharacterTokenizer) -> dict:
+    completion = "    return x + 1\n"
+    generated_ids = tokenizer.encode(completion, add_special_tokens=False)
+    return {
+        "task_id": 1,
+        "completion": completion,
+        "generated_token_ids": generated_ids,
+        "generated_tokens": len(generated_ids),
+        "completion_sha256": "completion",
+        "token_ids_sha256": "tokens",
+        "teacher_total_logprob": -2.0,
+        "teacher_mean_logprob": -0.1,
+        "generation_round": 0,
+        "sample_index": 1,
+        "finish_reason": "stop",
+        "stop_reason": "```",
+        "execution_verified": True,
+        "eligible": True,
+    }
+
+
+def test_assemble_teacher_native_row_preserves_generated_token_prefix():
+    source = _source()
+    tokenizer = CharacterTokenizer("def add_one(x):\n")
+    candidate = _candidate(tokenizer)
+
+    row = assemble_teacher_native_row(
+        source,
+        candidate,
+        tokenizer,
+        max_response_length=128,
+    )
+
+    assert row["agent_name"] == "teacher_forcing_agent"
+    assert row["extra_info"]["answer"].startswith(ASSISTANT_PREFIX_NO_THINK + "def add_one(x):\n")
+    assert row["extra_info"]["response_token_ids"][: candidate["generated_tokens"]] == candidate[
+        "generated_token_ids"
+    ]
+    assert row["extra_info"]["teacher_native_execution_verified"] is True
+
+
+def test_assemble_teacher_native_row_rejects_overlong_response():
+    source = _source()
+    tokenizer = CharacterTokenizer("def add_one(x):\n")
+
+    with pytest.raises(ValueError, match="above max_response_length"):
+        assemble_teacher_native_row(
+            source,
+            _candidate(tokenizer),
+            tokenizer,
+            max_response_length=4,
+        )
+
+
+def test_select_best_verified_candidate_uses_mean_logprob_then_length():
+    candidates = [
+        {
+            "eligible": True,
+            "teacher_mean_logprob": -0.5,
+            "generated_tokens": 2,
+            "completion_sha256": "a",
+            "token_ids_sha256": "a",
+        },
+        {
+            "eligible": True,
+            "teacher_mean_logprob": -0.1,
+            "generated_tokens": 9,
+            "completion_sha256": "b",
+            "token_ids_sha256": "b",
+        },
+        {
+            "eligible": False,
+            "teacher_mean_logprob": 0.0,
+            "generated_tokens": 1,
+            "completion_sha256": "c",
+            "token_ids_sha256": "c",
+        },
+    ]
+
+    selected = select_best_verified_candidate(candidates)
+
+    assert selected["completion_sha256"] == "b"
