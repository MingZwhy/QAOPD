+import json
+
+from examples.on_policy_distillation_trainer.prepare_mbpp_frontier_curriculum import (
+    canonical_ground_truth,
+    row_task_id,
+    scan_frontier_tasks,
+    select_frontier_rows,
+)
+
+
+def _ground_truth(function_name: str, marker: str) -> dict:
+    return {"function_name": function_name, "function_stub": marker, "tests": [f"assert {marker}"]}
+
+
+def _record(function_name: str, marker: str, score: float) -> str:
+    return json.dumps({"gts": json.dumps(_ground_truth(function_name, marker)), "score": score})
+
+
+def test_scan_frontier_tasks_requires_both_full_pass_and_failure(tmp_path):
+    (tmp_path / "1.jsonl").write_text(
+        "\n".join(
+            [
+                _record("frontier", "frontier", 0.0),
+                _record("frontier", "frontier", 1.0),
+                _record("always_passes", "always", 1.0),
+                _record("always_passes", "always", 1.0),
+                _record("never_passes", "never", 0.5),
+                _record("never_passes", "never", 0.0),
+            ]
+        )
+        + "\n"
+    )
+    (tmp_path / "11.jsonl").write_text(_record("too_late", "late", 1.0) + "\n")
+
+    frontier = scan_frontier_tasks(tmp_path, max_step=10)
+    task_key = canonical_ground_truth(_ground_truth("frontier", "frontier"))
+
+    assert set(frontier) == {task_key}
+    assert frontier[task_key] == {
+        "function_name": "frontier",
+        "samples": 2,
+        "min_score": 0.0,
+        "max_score": 1.0,
+        "full_passes": 1,
+    }
+
+
+def test_select_frontier_rows_preserves_schema_and_orders_by_task_id():
+    first_ground_truth = _ground_truth("duplicate_name", "first")
+    second_ground_truth = _ground_truth("duplicate_name", "second")
+    source_rows = [
+        {
+            "prompt": "b",
+            "reward_model": {"ground_truth": json.dumps(second_ground_truth)},
+            "extra_info": {"task_id": 20, "function_name": "duplicate_name"},
+        },
+        {
+            "prompt": "a",
+            "reward_model": {"ground_truth": json.dumps(first_ground_truth)},
+            "extra_info": {"task_id": 10, "function_name": "duplicate_name"},
+        },
+    ]
+
+    selected = select_frontier_rows(
+        source_rows,
+        {canonical_ground_truth(first_ground_truth), canonical_ground_truth(second_ground_truth)},
+    )
+
+    assert [row["prompt"] for row in selected] == ["a", "b"]
+    assert [row["extra_info"]["index"] for row in selected] == [0, 1]
+    assert all(row["extra_info"]["curriculum"] == "on_policy_frontier" for row in selected)
+
+
+def test_row_task_id_supports_mbpp_and_apps_schemas():
+    assert row_task_id({"extra_info": {"task_id": 10}}) == 10
+    assert row_task_id({"task_id": 1_000_020, "extra_info": {"source_task_id": 20}}) == 1_000_020
diff --git a/tests/experimental/reward_loop/test_prepare_mbpp_humaneval_on_cpu.py b/tests/experimental/reward_loop/test_prepare_mbpp_humaneval_on_cpu.py
