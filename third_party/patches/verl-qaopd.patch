+            dp_size=1,
+        )
+
+
+def test_paired_dpo_batch_layout_requires_even_pairs_per_rank():
+    with pytest.raises(ValueError, match="divide evenly"):
+        paired_dpo_batch_layout(
+            ["a_0_0", "a_1_0", "b_0_0", "b_1_0", "c_0_0", "c_1_0"],
