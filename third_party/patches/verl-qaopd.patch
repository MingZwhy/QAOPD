@@ -0,0 +1,82 @@
+import sys
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+
+SCRIPT = (
+    Path(__file__).parents[3]
+    / "examples"
+    / "on_policy_distillation_trainer"
+    / "analyze_opd_eval_results.py"
+)
+SPEC = spec_from_file_location("analyze_opd_eval_results", SCRIPT)
+MODULE = module_from_spec(SPEC)
+assert SPEC and SPEC.loader
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+
+def _sample(doc_id, passed, prompt_hash="prompt"):
+    return {
+        "doc_id": doc_id,
+        "doc_hash": f"doc-{doc_id}",
+        "prompt_hash": prompt_hash,
+        "target_hash": f"target-{doc_id}",
+        "arguments": {"max_gen_toks": 1024},
+        "pass@1": float(passed),
+    }
+
+
+def _gsm_sample(doc_id, passed, filter_name):
+    sample = _sample(doc_id, passed)
+    sample.pop("pass@1")
+    sample["filter"] = filter_name
+    sample["exact_match"] = float(passed)
+    return sample
+
+
+def test_exact_mcnemar_is_two_sided():
+    assert MODULE.exact_mcnemar_p(6, 7) == 1.0
+    assert MODULE.exact_mcnemar_p(0, 10) == 2 / 1024
+
+
+def test_paired_humaneval_counts_transitions_and_checks_protocol():
+    baseline = {0: _sample(0, True), 1: _sample(1, False), 2: _sample(2, False)}
+    candidate = {0: _sample(0, False), 1: _sample(1, True), 2: _sample(2, False)}
+
+    result = MODULE.paired_humaneval(baseline, candidate)
+
+    assert result["gains"] == 1
+    assert result["losses"] == 1
+    assert result["both_wrong"] == 1
+    assert result["mcnemar_p"] == 1.0
+
+
+def test_paired_gsm8k_counts_each_filter_independently():
+    baseline = {
+        "strict-match": {
+            0: _gsm_sample(0, True, "strict-match"),
+            1: _gsm_sample(1, False, "strict-match"),
+        },
+        "flexible-extract": {
+            0: _gsm_sample(0, True, "flexible-extract"),
+            1: _gsm_sample(1, False, "flexible-extract"),
+        },
+    }
+    candidate = {
+        "strict-match": {
+            0: _gsm_sample(0, False, "strict-match"),
+            1: _gsm_sample(1, True, "strict-match"),
+        },
+        "flexible-extract": {
+            0: _gsm_sample(0, True, "flexible-extract"),
+            1: _gsm_sample(1, True, "flexible-extract"),
+        },
+    }
+
+    strict = MODULE.paired_gsm8k(baseline, candidate, "strict-match")
+    flexible = MODULE.paired_gsm8k(baseline, candidate, "flexible-extract")
+
+    assert strict["gains"] == 1
+    assert strict["losses"] == 1
+    assert flexible["gains"] == 1
+    assert flexible["losses"] == 0
