+def paired_dpo_batch_layout(keys: list[str], tags: list[dict], dp_size: int) -> tuple[list[int], list[list[int]]]:
+    """Order fixed preference sessions and keep every pair on one DP rank."""
+    parsed = []
+    for index, key in enumerate(keys):
+        parts = key.rsplit("_", 2)
+        if len(parts) != 3:
+            raise ValueError(f"paired_dpo received malformed trajectory key: {key}")
+        uid, raw_session_id, raw_output_index = parts
+        parsed.append((uid, int(raw_session_id), int(raw_output_index), index))
+
+    order = [item[3] for item in sorted(parsed)]
+    ordered = [parsed[index] for index in order]
+    groups: dict[str, list[tuple[int, int]]] = {}
+    for uid, session_id, output_index, _ in ordered:
+        groups.setdefault(uid, []).append((session_id, output_index))
+    malformed = {uid: values for uid, values in groups.items() if values != [(0, 0), (1, 0)]}
+    if malformed:
+        raise ValueError(f"paired_dpo requires exactly sessions [(0, 0), (1, 0)] per uid: {malformed}")
+    if len(groups) % dp_size:
+        raise ValueError(f"paired_dpo pair count {len(groups)} must divide evenly across dp_size={dp_size}")
+
+    ordered_seqlens = [int(tags[index]["seq_len"]) for index in order]
+    ordered_uids = [item[0] for item in ordered]
+    partitions = get_group_balanced_partitions(
+        seqlen_list=ordered_seqlens,
+        uid_list=ordered_uids,
+        k_partitions=dp_size,
+    )
+    return order, partitions
+
