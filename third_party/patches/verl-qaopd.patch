+from examples.on_policy_distillation_trainer.gsm8k_boxed_reward import compute_score
+
+
+def test_compute_score_is_format_tolerant_by_default():
+    assert compute_score("openai/gsm8k", "The answer is 42.", "42") == 1.0
+    assert compute_score("openai/gsm8k", r"Therefore, \boxed{42}.", "42") == 1.0
+
+
+def test_compute_score_can_require_hash_answer_format():
+    assert compute_score("openai/gsm8k", "Answer: 42", "42", require_hash=True) == 0.0
+    assert compute_score("openai/gsm8k", "Work. #### 42", "42", require_hash=True) == 1.0
+    assert compute_score("openai/gsm8k", "Work. #### 41", "42", require_hash=True) == 0.0
+
+
+def test_compute_score_can_shape_correctness_and_hash_format():
+    kwargs = {
+        "require_hash": True,
+        "correct_without_hash_score": 0.25,
+        "hash_format_score": 0.1,
+    }
+    assert compute_score("openai/gsm8k", "Answer: 42", "42", **kwargs) == 0.25
+    assert compute_score("openai/gsm8k", "Work. #### 41", "42", **kwargs) == 0.1
+    assert compute_score("openai/gsm8k", "Answer: 41", "42", **kwargs) == 0.0
+    assert compute_score("openai/gsm8k", "Work. #### 42", "42", **kwargs) == 1.0
+    assert compute_score("openai/gsm8k", "Work. #### $42", "42", **kwargs) == 0.25
