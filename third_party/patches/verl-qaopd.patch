+    student_on_teacher_log_probs = torch.gather(student_log_probs, dim=-1, index=teacher_topk_ids)
+
+    overlap_mask = (teacher_topk_ids.unsqueeze(-1) == student_topk_ids.unsqueeze(-2)).any(dim=-1)
+    overlap_count = overlap_mask.sum(dim=-1)
+    has_overlap = overlap_count > 0
+
+    student_mass = (student_on_teacher_log_probs.exp() * overlap_mask).sum(dim=-1)
+    teacher_mass = (teacher_topk_log_probs.exp() * overlap_mask).sum(dim=-1)
+
+    loss_config: DistillationLossConfig = config.distillation_loss
+    if loss_config.log_prob_min_clamp is not None:
+        student_on_teacher_log_probs = student_on_teacher_log_probs.clamp_min(loss_config.log_prob_min_clamp)
+        teacher_topk_log_probs = teacher_topk_log_probs.clamp_min(loss_config.log_prob_min_clamp)
