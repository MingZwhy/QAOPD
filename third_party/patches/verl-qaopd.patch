+def set_trainable_param_patterns(module: torch.nn.Module, patterns: list[str]) -> tuple[int, int]:
+    """Freeze parameters outside a regex allowlist and return trainable counts."""
+    compiled = [re.compile(pattern) for pattern in patterns]
+    matched_names = []
+    trainable_numel = 0
+    total_numel = 0
+    for name, parameter in module.named_parameters():
+        trainable = any(pattern.search(name) for pattern in compiled)
+        parameter.requires_grad_(trainable)
+        total_numel += parameter.numel()
+        if trainable:
+            matched_names.append(name)
+            trainable_numel += parameter.numel()
+    if not matched_names:
+        raise ValueError(f"trainable_param_patterns matched no parameters: {patterns}")
+    logger.info(
+        "Trainable parameter allowlist matched %d tensors (%d/%d parameters)",
+        len(matched_names),
+        trainable_numel,
+        total_numel,
+    )
+    return len(matched_names), trainable_numel
+
