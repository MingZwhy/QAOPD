@@ -0,0 +1,133 @@
+import json
+
+import pytest
+
+from examples.on_policy_distillation_trainer.prepare_verified_code_replay import (
+    ASSISTANT_PREFIX,
+    build_validation_rows,
+    build_verified_replay_rows,
+    filter_replay_rows_by_response_length,
+)
+
+
+def _source(task_id: int = 1) -> dict:
+    ground_truth = {
+        "function_stub": "def add_one(x):\n",
+        "function_name": "add_one",
+        "tests": ["assert add_one(2) == 3"],
+        "test_setup_code": "",
+    }
+    return {
+        "task_id": task_id,
+        "data_source": "mbpp_humaneval",
+        "prompt": [{"role": "user", "content": "complete add_one"}],
+        "ability": "code",
+        "reward_model": {"style": "rule", "ground_truth": json.dumps(ground_truth)},
+        "extra_info": {"function_name": "add_one", "task_id": task_id},
+    }
+
+
+def _rollout(source: dict, output: str, *, score: float = 1.0, path: str = "/tmp/1.jsonl") -> dict:
+    return {
+        "gts": source["reward_model"]["ground_truth"],
+        "output": output,
+        "score": score,
+        "step": 1,
+        "_rollout_path": path,
+    }
+
+
+def test_build_verified_replay_selects_shortest_unique_full_pass():
+    source = _source()
+    rollouts = [
+        _rollout(source, "    return x + 1\n```\n", path="/tmp/2.jsonl"),
+        _rollout(source, "    value = x + 1\n    return value\n```\n", path="/tmp/1.jsonl"),
+        _rollout(source, "    return 0\n```\n", score=0.0),
+    ]
+    verified = []
+
+    def verifier(**kwargs):
+        verified.append(kwargs)
+        return 1.0
+
+    rows, stats = build_verified_replay_rows([source], rollouts, verifier=verifier)
+
+    assert len(rows) == 1
+    assert rows[0]["agent_name"] == "teacher_forcing_agent"
+    assert rows[0]["extra_info"]["answer"] == ASSISTANT_PREFIX + "def add_one(x):\n    return x + 1\n```\n"
+    assert rows[0]["extra_info"]["replay_rollout_path"] == "/tmp/2.jsonl"
+    assert verified[0]["require_all_tests"] is True
+    assert stats["reported_full_passes"] == 2
+    assert stats["unique_successful_outputs"] == 2
+
+
+def test_build_verified_replay_rejects_missing_or_unverifiable_success():
+    source = _source()
+    with pytest.raises(ValueError, match="No full-pass rollout"):
+        build_verified_replay_rows([source], [_rollout(source, "bad", score=0.0)])
+
+    with pytest.raises(ValueError, match="failed replay verification"):
+        build_verified_replay_rows([source], [_rollout(source, "    return x + 1\n")], verifier=lambda **_: 0.0)
+
+
+def test_build_validation_rows_forces_on_policy_agent_and_removes_answer():
+    source = _source()
+    source["agent_name"] = "teacher_forcing_agent"
+    source["extra_info"]["answer"] = "old answer"
+
+    rows = build_validation_rows([source])
+
+    assert rows[0]["agent_name"] == "single_turn_agent"
+    assert "answer" not in rows[0]["extra_info"]
+    assert rows[0]["extra_info"]["split"] == "validation"
+
+
+class CharacterTokenizer:
+    @staticmethod
+    def encode(text, *, add_special_tokens):
+        assert add_special_tokens is False
+        return [1000 + ord(character) for character in text]
+
+    @staticmethod
+    def decode(token_ids, *, skip_special_tokens, clean_up_tokenization_spaces):
+        assert skip_special_tokens is False
+        assert clean_up_tokenization_spaces is False
+        return "".join(chr(int(token_id) - 1000) for token_id in token_ids)
+
+    def apply_chat_template(self, messages, *, add_generation_prompt, tokenize, **kwargs):
+        assert kwargs == {"enable_thinking": False}
+        prefix = "PROMPT" + ASSISTANT_PREFIX + "def add_one(x):\n"
+        text = prefix if add_generation_prompt else "PROMPT" + messages[-1]["content"] + "<END>"
+        return self.encode(text, add_special_tokens=False) if tokenize else text
+
+
+def test_filter_replay_rows_by_exact_response_length():
+    source = _source()
+    short = _rollout(source, "    return x + 1\n```\n")
+    rows, _ = build_verified_replay_rows(
+        [source],
+        [short],
+        verifier=lambda **_: 1.0,
+    )
+    long_row = json.loads(json.dumps(rows[0]))
+    long_row["task_id"] = 2
+    long_row["extra_info"]["answer"] = (
+        ASSISTANT_PREFIX + "def add_one(x):\n    return x + 123456789\n```\n"
+    )
+    long_row["extra_info"]["replay_output_sha256"] = "long"
+    rows.append(long_row)
+
+    kept, excluded = filter_replay_rows_by_response_length(
+        rows,
+        CharacterTokenizer(),
+        max_response_length=30,
+    )
+
+    assert [row["task_id"] for row in kept] == [1]
+    assert kept[0]["extra_info"]["index"] == 0
+    assert kept[0]["extra_info"]["replay_response_tokens"] <= 30
+    assert len(excluded) == 1
+    assert excluded[0]["task_id"] == "2"
+    assert excluded[0]["function_name"] == "add_one"
+    assert excluded[0]["response_tokens"] > 30
+    assert excluded[0]["output_sha256"] == "long"
