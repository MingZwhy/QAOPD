+import json
+
+from examples.on_policy_distillation_trainer.prepare_apps_humaneval import (
+    EQUALITY_SETUP,
+    build_function_stub,
+    build_prompt,
+    build_tests,
+    contamination_score,
+    prepare_rows,
+)
+
+
+class FakeTokenizer:
+    def apply_chat_template(self, messages, **kwargs):
+        return list(range(len(messages[0]["content"].split())))
+
+
+def source_row(problem_id: int, question: str = "Return twice the input.") -> dict:
+    return {
+        "problem_id": problem_id,
+        "question": question,
+        "solutions": json.dumps(["def double(x):\n    return 2 * x\n"]),
+        "input_output": json.dumps(
+            {"fn_name": "double", "inputs": [[2], [-3]], "outputs": [4, -6]}
+        ),
+        "difficulty": "introductory",
+        "url": "https://example.test/problem",
+        "starter_code": "def double(x):\n    ",
+    }
+
+
+def test_build_tests_and_stub_match_humaneval_prefill():
+    tests = build_tests([[2], [-3]], [4, -6], "double")
+    stub = build_function_stub("def double(x):\n    ", "Return twice the input.", "double", tests)
+
+    assert tests == [
+        "assert __apps_equal_output(double(2), 4)",
+        "assert __apps_equal_output(double(-3), -6)",
+    ]
+    assert stub.startswith("from typing import *\n\n\ndef double(x):\n")
+    assert '    """ Return twice the input.\n    >>> double(2)' in stub
+    assert stub.endswith('    """\n\n')
+    prompt = build_prompt(stub)[0]["content"]
+    extracted = prompt.split("```python\n", 1)[1].split("\n```", 1)[0] + "\n"
+    assert extracted == stub
+
+
+def test_build_function_stub_sanitizes_nested_markdown_fences():
+    tests = build_tests([[2]], [[4]], "double")
+    stub = build_function_stub(
+        "def double(x):\n    ",
+        "Example:\n```python\ndouble(2)\n```",
+        "double",
+        tests,
+    )
+    prompt = build_prompt(stub)[0]["content"]
+
+    assert "```python\ndouble(2)" not in stub
+    assert "    ~~~python\n    double(2)\n    ~~~" in stub
+    assert "    >>> double(2)\n    4" in stub
+    assert prompt.count("```") == 2
+
+
+def test_prepare_rows_validates_references_and_serializes_call_tests():
+    rows = [source_row(problem_id) for problem_id in range(3)]
+    train, validation, manifest = prepare_rows(
+        rows,
+        FakeTokenizer(),
+        "unused",
+        val_size=1,
+        max_prompt_length=200,
+        seed=7,
+    )
+
+    assert len(train) == 2
+    assert len(validation) == 1
+    assert manifest["reference_validation"] is True
+    prepared = train[0]
+    assert prepared["data_source"] == "apps_humaneval"
+    assert prepared["task_id"] >= 1_000_000
+    reference = json.loads(prepared["reward_model"]["ground_truth"])
+    assert reference["test_setup_code"] == EQUALITY_SETUP
+    assert len(reference["tests"]) == 2
+
+
+def test_prepare_rows_rejects_methods_bad_references_and_contamination():
+    method = source_row(1)
+    method["starter_code"] = "class Solution:\n    def double(self, x):\n        "
+    bad_reference = source_row(2)
+    bad_reference["solutions"] = json.dumps(["def double(x):\n    return x\n"])
+    contaminated = source_row(3, "Check if two numbers are close enough to each other in a list.")
+    clean = source_row(4)
+
+    train, validation, manifest = prepare_rows(
+        [method, bad_reference, contaminated, clean],
+        FakeTokenizer(),
+        "unused",
+        val_size=0,
+        max_prompt_length=200,
+        seed=7,
+        humaneval_descriptions=["Check if two numbers are close enough to each other in a list."],
+    )
+
+    assert not validation
+    assert len(train) == 1
+    assert manifest["filter_counts"]["unsupported_starter"] == 1
+    assert manifest["filter_counts"]["reference_failed"] == 1
+    assert manifest["filter_counts"]["humaneval_contamination"] == 1
+
+
+def test_contamination_score_uses_exact_eight_token_overlap():
+    description = "Return the sum of all positive integers in the supplied list safely."
+    assert contamination_score(description, [description]) == 1.0
+    assert contamination_score(description, ["Compute a matrix determinant."]) == 0.0
+
+
+def test_build_tests_accepts_apps_singleton_outputs_and_restores_integer_keys():
+    tests = build_tests([[{"1": "one"}]], [["one"]], "lookup")
+    reference = {
+        "function_stub": "def lookup(values):\n    ",
+        "tests": tests,
+        "test_setup_code": EQUALITY_SETUP,
+    }
+
+    from examples.on_policy_distillation_trainer.mbpp_execution_reward import compute_score
+
+    assert compute_score("apps_humaneval", "    return values[1]\n", json.dumps(reference)) == 1.0
