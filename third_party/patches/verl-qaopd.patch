+import pytest
+
+from examples.on_policy_distillation_trainer.prepare_mbpp_hybrid_trajectories import (
+    build_hybrid_rows,
+)
+
+
+def _row(task_id: int, *, reference: bool) -> dict:
+    row = {
+        "task_id": task_id,
+        "data_source": "mbpp_humaneval",
+        "prompt": [{"role": "user", "content": f"task {task_id}"}],
+        "ability": "code",
+        "reward_model": {"style": "rule", "ground_truth": f"tests-{task_id}"},
+        "extra_info": {
+            "source_dataset": "mbpp",
+            "source_split": "train",
+            "task_id": task_id,
+            "function_name": f"fn_{task_id}",
+            "split": "train",
+            "index": task_id,
+        },
+    }
+    if reference:
+        row["agent_name"] = "teacher_forcing_agent"
+        row["extra_info"]["answer"] = f"answer-{task_id}"
+    return row
+
+
+def test_build_hybrid_rows_pairs_agents_and_aligns_schema():
+    on_policy = [_row(2, reference=False), _row(1, reference=False)]
+    references = [_row(1, reference=True), _row(2, reference=True)]
+
+    rows = build_hybrid_rows(on_policy, references, include_references=True)
+
+    assert [row["task_id"] for row in rows] == [1, 1, 2, 2]
+    assert [row["agent_name"] for row in rows] == [
+        "single_turn_agent",
+        "teacher_forcing_agent",
+        "single_turn_agent",
+        "teacher_forcing_agent",
+    ]
+    assert all(row["extra_info"]["answer"].startswith("answer-") for row in rows)
+
+
+def test_build_hybrid_rows_keeps_validation_on_policy_only():
+    rows = build_hybrid_rows(
+        [_row(1, reference=False)],
+        [_row(1, reference=True)],
+        include_references=False,
+    )
+
+    assert len(rows) == 1
+    assert rows[0]["agent_name"] == "single_turn_agent"
+
+
+def test_build_hybrid_rows_supports_reference_only_training():
+    rows = build_hybrid_rows(
+        [_row(1, reference=False)],
+        [_row(1, reference=True)],
+        include_references=True,
+        include_on_policy=False,
+    )
+
+    assert len(rows) == 1
+    assert rows[0]["agent_name"] == "teacher_forcing_agent"
+    assert rows[0]["extra_info"]["answer"] == "answer-1"
+
+
+def test_build_hybrid_rows_rejects_protocol_mismatch():
+    on_policy = _row(1, reference=False)
+    reference = _row(1, reference=True)
+    reference["prompt"][0]["content"] = "different prompt"
+
+    with pytest.raises(ValueError, match="Mismatched prompt"):
+        build_hybrid_rows([on_policy], [reference], include_references=True)
