+import json
+import sys
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+
+import pandas as pd
+
+SCRIPT = (
+    Path(__file__).parents[3]
+    / "examples"
+    / "on_policy_distillation_trainer"
+    / "select_execution_frontier.py"
+)
+SPEC = spec_from_file_location("select_execution_frontier", SCRIPT)
+MODULE = module_from_spec(SPEC)
+assert SPEC and SPEC.loader
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+
+def _source() -> pd.DataFrame:
+    return pd.DataFrame(
+        [
+            {
+                "task_id": task_id,
+                "reward_model": {"ground_truth": f"gt-{task_id}", "style": "rule"},
+                "extra_info": {"split": "validation", "index": index},
+            }
+            for index, task_id in enumerate((10, 20, 30))
+        ]
+    )
+
+
+def test_load_rollout_scores_groups_repeated_observations(tmp_path: Path) -> None:
+    path = tmp_path / "rollouts.jsonl"
+    rows = [
+        {"gts": "gt-10", "score": 0.25},
+        {"gts": "gt-10", "reward": 0.75},
+        {"gts": "gt-20", "score": 1.0},
+    ]
+    path.write_text("".join(json.dumps(row) + "\n" for row in rows), encoding="utf-8")
+
+    assert MODULE.load_rollout_scores([path]) == {"gt-10": [0.25, 0.75], "gt-20": [1.0]}
+
+
+def test_select_frontier_keeps_only_partial_mean_scores() -> None:
+    selected, manifest = MODULE.select_frontier(
+        _source(),
+        {"gt-10": [0.0], "gt-20": [0.25, 0.75], "gt-30": [1.0]},
+        min_score=1e-9,
+        max_score=1.0 - 1e-9,
+    )
+
+    assert selected["task_id"].tolist() == [20]
+    assert selected.iloc[0]["extra_info"] == {"split": "train", "index": 0}
+    assert manifest["selected_rows"] == 1
+    assert manifest["selected_scores"]["20"] == {
+        "mean": 0.5,
+        "observations": 2,
+        "full_passes": 0,
+        "failures": 2,
+    }
+
+
+def test_select_frontier_can_require_mixed_exact_success() -> None:
+    selected, manifest = MODULE.select_frontier(
+        _source(),
+        {
+            "gt-10": [0.0, 0.5],
+            "gt-20": [0.0, 1.0],
+            "gt-30": [1.0, 1.0],
+        },
+        min_score=0.0,
+        max_score=1.0,
+        require_full_pass_and_failure=True,
+    )
+
+    assert selected["task_id"].tolist() == [20]
+    assert manifest["require_full_pass_and_failure"] is True
+    assert manifest["selected_scores"]["20"] == {
+        "mean": 0.5,
+        "observations": 2,
+        "full_passes": 1,
+        "failures": 1,
+    }
+
+
+def test_select_frontier_rejects_unknown_ground_truth() -> None:
+    try:
+        MODULE.select_frontier(_source(), {"missing": [0.5]}, min_score=0.0, max_score=1.0)
+    except ValueError as error:
+        assert "absent" in str(error)
+    else:
+        raise AssertionError("unknown ground truth should be rejected")
