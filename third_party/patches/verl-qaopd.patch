+import json
+
+import pandas as pd
+import pytest
+
+from examples.on_policy_distillation_trainer.analyze_mbpp_official_eval import (
+    compare,
+    exact_mcnemar_p_value,
+)
+from examples.on_policy_distillation_trainer.prepare_mbpp_official_protocol import (
+    build_official_splits,
+)
+
+
+def _row(task_id: int, source_split: str) -> dict:
+    ground_truth = {
+        "function_stub": f"def task_{task_id}():\n",
+        "function_name": f"task_{task_id}",
+        "tests": [f"assert task_{task_id}() == {task_id}"],
+        "test_setup_code": "",
+    }
+    return {
+        "task_id": task_id,
+        "data_source": "mbpp_humaneval",
+        "prompt": [{"role": "user", "content": f"task {task_id}"}],
+        "ability": "code",
+        "reward_model": {"style": "rule", "ground_truth": json.dumps(ground_truth)},
+        "extra_info": {"source_split": source_split, "split": "old"},
+    }
+
+
+def test_build_official_splits_restores_source_boundaries(tmp_path):
+    prepared = tmp_path / "prepared"
+    prepared.mkdir()
+    pd.DataFrame([_row(1, "train"), _row(2, "test")]).to_parquet(
+        prepared / "train.parquet", index=False
+    )
+    pd.DataFrame([_row(3, "validation"), _row(4, "prompt")]).to_parquet(
+        prepared / "validation.parquet", index=False
+    )
+
+    splits, manifest = build_official_splits(prepared)
+
+    assert {name: [row["task_id"] for row in rows] for name, rows in splits.items()} == {
+        "train": [1],
+        "validation": [3],
+        "test": [2],
+    }
+    assert manifest["omitted_source_splits"] == {"prompt": 1}
+    assert splits["test"][0]["extra_info"]["protocol_split"] == "test"
+    assert splits["test"][0]["extra_info"]["split"] == "test"
+
+
+def test_build_official_splits_rejects_duplicate_tasks(tmp_path):
+    prepared = tmp_path / "prepared"
+    prepared.mkdir()
+    pd.DataFrame([_row(1, "train")]).to_parquet(prepared / "train.parquet", index=False)
+    pd.DataFrame([_row(1, "test")]).to_parquet(prepared / "validation.parquet", index=False)
+
+    with pytest.raises(ValueError, match="duplicate task IDs"):
+        build_official_splits(prepared)
+
+
+def test_paired_mbpp_comparison_and_exact_mcnemar():
+    baseline = {
+        "a": {"passed": False, "score": 0.0, "input_sha256": "a"},
+        "b": {"passed": True, "score": 1.0, "input_sha256": "b"},
+        "c": {"passed": False, "score": 0.0, "input_sha256": "c"},
+    }
+    candidate = {
+        "a": {"passed": True, "score": 1.0, "input_sha256": "a"},
+        "b": {"passed": False, "score": 0.0, "input_sha256": "b"},
+        "c": {"passed": True, "score": 1.0, "input_sha256": "c"},
+    }
+
+    result = compare(baseline, candidate)
+
+    assert result["paired_gains"] == 2
+    assert result["paired_losses"] == 1
+    assert result["delta_percentage_points"] == pytest.approx(100 / 3)
+    assert result["mcnemar_exact_p"] == exact_mcnemar_p_value(2, 1) == 1.0
