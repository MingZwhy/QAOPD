+import asyncio
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+from omegaconf import OmegaConf
+from tensordict import NonTensorData, TensorDict
+
+from verl.experimental.agent_loop.agent_loop import build_rollout_sampling_params
+
+
+def test_default_rollout_yaml_declares_optional_stop_strings():
+    config_path = Path(__file__).parents[3] / "verl/trainer/config/rollout/rollout.yaml"
+    config = OmegaConf.load(config_path)
+
+    assert config.stop is None
+    assert "stop" not in build_rollout_sampling_params(config)
+
+
+def test_build_sampling_params_forwards_configured_stop_strings():
+    config = SimpleNamespace(
+        temperature=1.0,
+        top_p=1.0,
+        top_k=-1,
+        calculate_log_probs=False,
+        stop=["Question:", "</s>"],
+    )
+
+    params = build_rollout_sampling_params(config)
+
+    assert params["stop"] == ["Question:", "</s>"]
+
+
+def test_build_sampling_params_omits_empty_stop_strings():
+    config = SimpleNamespace(
+        temperature=1.0,
+        top_p=1.0,
+        top_k=-1,
+        calculate_log_probs=False,
+        stop=None,
+    )
+
+    assert "stop" not in build_rollout_sampling_params(config)
+
+
+def test_build_sampling_params_forwards_configured_bad_words():
+    config = SimpleNamespace(
+        temperature=1.0,
+        top_p=1.0,
+        top_k=-1,
+        calculate_log_probs=False,
+        stop=["```"],
+        bad_words=["<think>", "</think>", "<tool_response>", "</tool_response>"],
+    )
+
+    params = build_rollout_sampling_params(config)
+
+    assert params["stop"] == ["```"]
+    assert params["bad_words"] == ["<think>", "</think>", "<tool_response>", "</tool_response>"]
+
+
+def test_transfer_queue_worker_forwards_stop_strings(monkeypatch):
+    import verl.trainer.ppo.v1.agent_loop_tq as agent_loop_tq
+
+    async def exercise_worker() -> list[dict]:
+        worker_cls = agent_loop_tq.AgentLoopWorkerTQ.__ray_metadata__.modified_class
+        worker = object.__new__(worker_cls)
+        rollout = SimpleNamespace(
+            temperature=1.0,
+            top_p=1.0,
+            top_k=-1,
+            calculate_log_probs=False,
+            stop=["Question:"],
+            bad_words=["<think>"],
+            agent=SimpleNamespace(default_agent_loop="single_turn_agent"),
+            n=1,
+            val_kwargs=SimpleNamespace(n=1, top_p=1.0, top_k=-1, temperature=0.0),
+        )
+        worker.config = SimpleNamespace(actor_rollout_ref=SimpleNamespace(rollout=rollout))
+        worker.background_tasks = set()
+        seen_params = []
+
+        async def fake_run_prompt(prompt, sampling_params, trajectory, trace=False):
+            seen_params.append(dict(sampling_params))
+
+        async def fake_trajectory_info(*args):
+            return [{"validate": False}]
+
+        worker._run_prompt = fake_run_prompt
+        monkeypatch.setattr(agent_loop_tq, "get_trajectory_info", fake_trajectory_info)
+        batch = TensorDict(
+            {
+                "uid": NonTensorData("sample-0"),
+                "index": torch.tensor([0]),
+                "global_steps": NonTensorData(1),
+            },
+            batch_size=[1],
+        )
+
+        await worker.generate_sequences(batch)
+        await asyncio.gather(*worker.background_tasks)
+        return seen_params
+
+    params = asyncio.run(exercise_worker())[0]
+    assert params["stop"] == ["Question:"]
+    assert params["bad_words"] == ["<think>"]
diff --git a/tests/experimental/agent_loop/test_teacher_forcing_agent_loop_on_cpu.py b/tests/experimental/agent_loop/test_teacher_forcing_agent_loop_on_cpu.py
