+import json
+
+import pytest
+
+from examples.on_policy_distillation_trainer.prepare_code_frontier_mix import merge_rows
+
+
+def _row(
+    task_id: int,
+    function_name: str,
+    marker: str,
+    *,
+    apps: bool = False,
+    replay_answer: str | None = None,
+) -> dict:
+    extra_info = {"function_name": function_name}
+    if apps:
+        extra_info["source_task_id"] = task_id - 1_000_000
+    else:
+        extra_info["task_id"] = task_id
+    if replay_answer is not None:
+        extra_info.update(
+            {
+                "answer": replay_answer,
+                "replay_verified_score": 1.0,
+                "teacher_mean_logprob": -0.25,
+                "teacher_response_tokens": 8,
+            }
+        )
+    return {
+        "task_id": task_id,
+        "reward_model": {
+            "ground_truth": json.dumps(
+                {"function_name": function_name, "function_stub": marker, "tests": [f"assert {marker}"]}
+            )
+        },
+        "extra_info": extra_info,
+    }
+
+
+def test_merge_rows_normalizes_schema_and_is_deterministic():
+    sources = [
+        ("mbpp", [_row(10, "mbpp_fn", "mbpp", replay_answer="def mbpp_fn(): pass")]),
+        ("apps", [_row(1_000_020, "apps_fn", "apps", apps=True)]),
+    ]
+
+    first, first_keys = merge_rows(sources, split="train", seed=7)
+    second, second_keys = merge_rows(sources, split="train", seed=7)
+
+    assert [row["task_id"] for row in first] == [row["task_id"] for row in second]
+    assert first_keys == second_keys
+    assert {row["extra_info"]["frontier_source"] for row in first} == {"mbpp", "apps"}
+    assert [row["extra_info"]["index"] for row in first] == list(range(2))
+    assert all(set(row["extra_info"]) == set(first[0]["extra_info"]) for row in first)
+    replay_row = next(row for row in first if row["extra_info"]["frontier_source"] == "mbpp")
+    assert replay_row["extra_info"]["answer"] == "def mbpp_fn(): pass"
+    assert replay_row["extra_info"]["replay_verified_score"] == 1.0
+    assert replay_row["extra_info"]["teacher_mean_logprob"] == -0.25
+    assert replay_row["extra_info"]["teacher_response_tokens"] == 8
+
+
+def test_merge_rows_rejects_duplicate_task_ids():
+    sources = [("first", [_row(10, "first", "first")]), ("second", [_row(10, "second", "second")])]
+    with pytest.raises(ValueError, match="Duplicate task_id=10"):
+        merge_rows(sources, split="train", seed=7)
