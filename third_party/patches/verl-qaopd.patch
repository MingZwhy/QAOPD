+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+
+from verl.utils.qat.edgerazor import (
+    apply_edgerazor_qat,
+    build_vllm_quantization_config,
+)
+
+
+def _qat_config_path() -> Path:
+    return (
+        Path(__file__).parents[2]
+        / "examples"
+        / "on_policy_distillation_trainer"
+        / "config"
+        / "edgerazor_w2_79a8_qwen3.yaml"
+    )
+
+
+def test_apply_edgerazor_qat_keeps_latent_parameters_trainable():
+    class ToyModel(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.embed_tokens = torch.nn.Embedding(512, 256)
+            self.proj = torch.nn.Linear(256, 256, bias=False)
+
+        def forward(self, tokens):
+            return self.proj(self.embed_tokens(tokens))
+
+    model = apply_edgerazor_qat(ToyModel(), str(_qat_config_path()))
+    loss = model(torch.randint(0, 512, (2, 4))).float().square().mean()
+    loss.backward()
+
+    assert model.proj.weight.grad is not None
+    assert torch.isfinite(model.proj.weight.grad).all()
+    assert model.proj.weight.shape == (256, 256)
+
+
+def test_build_vllm_config_disables_real_kv_quantization():
+    config = build_vllm_quantization_config(
+        SimpleNamespace(edgerazor_quant_mode="w2_79a8kv8_embint4_qwen3")
+    )
+    assert config["quant_method"] == "edgerazor"
+    assert config["weight_bits"] == 2.79
+    assert config["activation_bits"] == 8
+    assert config["kv_cache_bits"] == 16
