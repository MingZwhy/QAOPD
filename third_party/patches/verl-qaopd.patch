+import json
+
+from examples.on_policy_distillation_trainer.mbpp_execution_reward import compute_score
+
+REFERENCE = json.dumps(
+    {
+        "function_stub": 'def double(x):\n    """Double x."""\n',
+        "function_name": "double",
+        "tests": ["assert double(2) == 4", "assert double(-3) == -6"],
+        "test_setup_code": "",
+    }
+)
+
+
+def test_execution_reward_scores_passing_and_partial_completions():
+    assert compute_score("mbpp_humaneval", "    return 2 * x\n```", REFERENCE) == 1.0
+    assert compute_score("apps_humaneval", "    return 2 * x\n```", REFERENCE) == 1.0
+    partial = compute_score("mbpp_humaneval", "    return max(0, 2 * x)\n```", REFERENCE)
+    assert partial == 0.5
+    assert (
