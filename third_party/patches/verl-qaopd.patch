+import ast
+
+from examples.on_policy_distillation_trainer.prepare_kodcode_profile_curriculum import (
+    augment_stub,
+    extract_direct_examples,
+    extract_reference_body,
+    infer_annotations,
+)
+
+STUB = '''def add_numbers(left, right):
+    """Return the sum of two integers."""
+
+'''
+
+
+def _tests():
+    return [
+        "def test_positive():\n    assert add_numbers(2, 3) == 5\ntest_positive()",
+        "def test_negative():\n    assert add_numbers(-2, 1) == -1\ntest_negative()",
+    ]
+
+
+def test_extract_reference_body_uses_first_opening_and_last_closing_fence():
+    answer = (
+        "<think>\n\n</think>\n\nHere is the completed function:\n```python\n"
+        f"{STUB}    return left + right\n"
+        "    # A literal ``` inside a comment must not truncate parsing.\n```\n"
+    )
+
+    body, lines = extract_reference_body(answer, STUB, "add_numbers")
+
+    assert "return left + right" in body
+    assert lines == 1
+
+
+def test_extract_examples_and_infer_complete_literal_signature():
+    examples = extract_direct_examples(_tests(), "add_numbers")
+
+    assert [example.render() for example in examples] == [
+        (">>> add_numbers(2, 3)", "5"),
+        (">>> add_numbers(-2, 1)", "-1"),
+    ]
+    assert infer_annotations(STUB, "add_numbers", examples) == (
+        {"left": "int", "right": "int"},
+        "int",
+    )
+
+
+def test_augment_stub_adds_doctests_and_annotations_without_answer():
+    examples = extract_direct_examples(_tests(), "add_numbers")
+    annotations = infer_annotations(STUB, "add_numbers", examples)
+
+    augmented = augment_stub(
+        STUB,
+        "add_numbers",
+        examples=examples[:1],
+        annotations=annotations,
+    )
+
+    tree = ast.parse(augmented)
+    function = tree.body[0]
+    assert ast.unparse(function.args.args[0].annotation) == "int"
+    assert ast.unparse(function.returns) == "int"
+    assert ">>> add_numbers(2, 3)" in ast.get_docstring(function)
+
+
+def test_infer_annotations_rejects_inconsistent_literal_types():
+    tests = [
+        "def test_int():\n    assert identity(1) == 1\ntest_int()",
+        "def test_str():\n    assert identity('x') == 'x'\ntest_str()",
+    ]
+    examples = extract_direct_examples(tests, "identity")
+
+    assert (
+        infer_annotations(
+            'def identity(value):\n    """Return the value."""\n\n',
+            "identity",
+            examples,
+        )
+        is None
+    )
