@@ -0,0 +1,163 @@
+import json
+
+from examples.on_policy_distillation_trainer.prepare_mbpp_humaneval import (
+    ASSISTANT_PREFIX_NO_THINK,
+    build_function_stub,
+    build_prompt,
+    build_reference_answer,
+    has_external_dependencies,
+    prepare_rows,
+)
+
+
+class FakeTokenizer:
+    def apply_chat_template(self, messages, **kwargs):
+        return list(range(len(messages[0]["content"].split())))
+
+
+def test_build_function_stub_selects_tested_function_and_examples():
+    stub, name = build_function_stub(
+        "import math\n\ndef helper(x): return x\n\ndef square(x: int) -> int:\n    return x*x\n",
+        "Return the square of x.",
+        ["assert square(3) == 9", "assert square(-2) == 4"],
+    )
+    assert name == "square"
+    assert stub.startswith("import math\n\n\ndef square(x: int) -> int:\n")
+    assert "def square(x: int) -> int:" in stub
+    assert '    """ Return the square of x.\n    >>> square(3)' in stub
+    assert "Examples:" not in stub
+    assert "return x*x" not in stub
+    assert stub.endswith('    """\n\n')
+    assert build_prompt(stub)[0]["content"].startswith("Write a solution")
+    extracted_stub = build_prompt(stub)[0]["content"].split("```python\n", 1)[1].split("\n```", 1)[0] + "\n"
+    assert extracted_stub.endswith("\n\n")
+
+
+def test_build_reference_answer_matches_prefill_and_keeps_canonical_body():
+    code = "import math\n\ndef square(x: int) -> int:\n    \"\"\"Old docstring.\"\"\"\n    return x*x\n"
+    stub, name = build_function_stub(code, "Return the square of x.", ["assert square(3) == 9"])
+
+    answer = build_reference_answer(code, stub, name)
+
+    assert answer.startswith("<think>\n\n</think>\n\nHere is the completed function:\n```python\n" + stub)
+    assert "Old docstring" not in answer
+    assert "    return x * x\n```" in answer
+
+
+def test_build_reference_answer_supports_no_think_compat_prefix():
+    code = "def square(x):\n    return x*x\n"
+    stub, name = build_function_stub(code, "Return the square of x.", ["assert square(3) == 9"])
+
+    answer = build_reference_answer(code, stub, name, ASSISTANT_PREFIX_NO_THINK)
+
+    assert answer.startswith("Here is the completed function:\n```python\n" + stub)
+    assert "<think>" not in answer
+
+
+def test_prepare_rows_holds_out_validation_and_serializes_tests():
+    source = [
+        {
+            "task_id": task_id,
+            "text": "Double x.",
+            "code": "def double(x):\n    return 2*x\n",
+            "test_list": [f"assert double({task_id}) == {2 * task_id}"],
+            "test_setup_code": "",
+            "_source_split": "test" if task_id == 3 else "train",
+        }
+        for task_id in range(4)
+    ]
+    train, validation, manifest = prepare_rows(source, FakeTokenizer(), "unused", 1, 100, 7)
+    assert len(train) == 3
+    assert len(validation) == 1
+    assert manifest["train_rows"] == 3
+    reference = json.loads(train[0]["reward_model"]["ground_truth"])
+    assert reference["function_name"] == "double"
+    assert len(reference["tests"]) == 1
+    assert {row["extra_info"]["source_split"] for row in train + validation} == {"train", "test"}
+
+
+def test_prepare_rows_deduplicates_task_ids_across_splits():
+    source = [
+        {
+            "task_id": 1,
+            "text": "Double x.",
+            "code": "def double(x):\n    return 2*x\n",
+            "test_list": ["assert double(2) == 4"],
+            "test_setup_code": "",
+            "_source_split": source_split,
+        }
+        for source_split in ("train", "test")
+    ]
+    source.append(
+        {
+            "task_id": 2,
+            "text": "Double x.",
+            "code": "def double(x):\n    return 2*x\n",
+            "test_list": ["assert double(3) == 6"],
+            "test_setup_code": "",
+            "_source_split": "validation",
+        }
+    )
+
+    train, validation, manifest = prepare_rows(source, FakeTokenizer(), "unused", 1, 100, 7)
+
+    assert len(train) + len(validation) == 2
+    assert manifest["filter_counts"]["duplicate_task_id"] == 1
+
+
+def test_prepare_rows_tracks_explicit_exclusions():
+    source = [
+        {
+            "task_id": task_id,
+            "text": "Double x.",
+            "code": "def double(x):\n    return 2*x\n",
+            "test_list": [f"assert double({task_id}) == {2 * task_id}"],
+            "test_setup_code": "",
+        }
+        for task_id in range(3)
+    ]
+
+    train, validation, manifest = prepare_rows(
+        source, FakeTokenizer(), "unused", 1, 100, 7, excluded_task_ids={2}
+    )
+
+    assert len(train) + len(validation) == 2
+    assert manifest["filter_counts"]["excluded_task_id"] == 1
+
+
+def test_prepare_rows_can_emit_teacher_forcing_trajectories():
+    source = [
+        {
+            "task_id": task_id,
+            "text": "Double x.",
+            "code": "def double(x):\n    return 2*x\n",
+            "test_list": [f"assert double({task_id}) == {2 * task_id}"],
+            "test_setup_code": "",
+        }
+        for task_id in range(3)
+    ]
+
+    train, validation, manifest = prepare_rows(
+        source, FakeTokenizer(), "unused", 1, 100, 7, teacher_forcing=True
+    )
+
+    for row in train + validation:
+        assert row["agent_name"] == "teacher_forcing_agent"
+        assert row["extra_info"]["answer"].endswith("```\n")
+        assert "return 2 * x" in row["extra_info"]["answer"]
+    assert manifest["trajectory_mode"] == "teacher_forcing"
+
+
+def test_external_dependency_filter_rejects_hidden_helpers():
+    assert has_external_dependencies(
+        "def helper(x): return x * 2\ndef target(x): return helper(x)",
+        "target",
+        ["assert target(2) == 4"],
+        "",
+    )
+    assert not has_external_dependencies(
+        "import math\ndef target(x): return math.floor(x)",
+        "target",
+        ["assert target(2.2) == 2"],
+        "",
+    )
