+from examples.on_policy_distillation_trainer.evaluate_humaneval_subset import (
+    build_candidate,
+    generation_arguments,
+    select_full_batches,
+)
+
+
+def test_generation_arguments_preserve_lm_eval_protocol():
+    sample = {
+        "arguments": {
+            "gen_args_0": {
+                "arg_0": "rendered prompt",
+                "arg_1": {"until": ["\ndef"], "do_sample": False},
+            }
+        }
+    }
+
+    prompt, kwargs = generation_arguments(sample)
+
+    assert prompt == "rendered prompt"
+    assert kwargs == {"until": ["\ndef"], "do_sample": False}
+
+
+def test_build_candidate_matches_humaneval_instruct_fence_filter():
+    sample = {"doc": {"prompt": "def answer():\n"}}
+
+    candidate = build_candidate(sample, "    return 42\n```\nignored")
+
+    assert candidate == "def answer():\n    return 42\n"
+
+
+class _Tokenizer:
+    def encode(self, prompt, *, add_special_tokens):
+        assert add_special_tokens is False
+        return prompt.split()
+
+
+def test_select_full_batches_keeps_original_length_sorted_peers():
+    samples = {
+        doc_id: {
+            "doc_id": doc_id,
+            "arguments": {"gen_args_0": {"arg_0": "x " * length, "arg_1": {}}},
+        }
+        for doc_id, length in enumerate([1, 6, 2, 5, 3, 4])
+    }
+
+    selected = select_full_batches(samples, [4], _Tokenizer(), batch_size=2)
+
+    assert [sample["doc_id"] for sample in selected] == [5, 4]
diff --git a/tests/experimental/reward_loop/test_generate_verified_mbpp_teacher_trajectories_on_cpu.py b/tests/experimental/reward_loop/test_generate_verified_mbpp_teacher_trajectories_on_cpu.py
