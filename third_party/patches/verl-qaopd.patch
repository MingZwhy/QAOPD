+    trainer = SimpleNamespace(
+        config=OmegaConf.create(
+            {
+                "actor_rollout_ref": {
+                    "model": {
+                        "path": "/tmp/model",
+                        "custom_chat_template": "configured template",
+                    }
+                },
+                "data": {"trust_remote_code": False},
+            }
+        )
+    )
+
+    trainer_base.PPOTrainer._init_tokenizer(trainer)
+
+    assert trainer.tokenizer.chat_template == "configured template"
+    assert trainer.processor.chat_template == "configured template"
