+import pandas as pd
+
+from examples.on_policy_distillation_trainer.prepare_mixed_opd_data import build_balanced_split
+
+
+def make_frame(domain, size):
+    rows = []
+    for index in range(size):
+        if domain == "math":
+            data_source = "openai/gsm8k"
+            ability = "math"
+            ground_truth = str(index)
+            extra_info = {"index": index, "question": f"Question {index}"}
+        else:
+            data_source = "apps"
+            ability = "code"
+            ground_truth = '{"inputs": ["1"], "outputs": ["1"]}'
+            extra_info = {
+                "problem_id": f"problem-{index}",
+                "source_id": str(index),
+                "difficulty": "introductory",
+                "problem_url": "",
+                "num_tests_original": 1,
+                "num_tests_kept": 1,
+            }
+        rows.append(
+            {
+                "data_source": data_source,
+                "prompt": [{"role": "user", "content": f"Prompt {index}"}],
+                "ability": ability,
+                "reward_model": {"style": "rule", "ground_truth": ground_truth},
+                "extra_info": extra_info,
+            }
+        )
+    return pd.DataFrame(rows)
+
+
+def test_balanced_split_alternates_domains_and_is_deterministic():
+    math = make_frame("math", 10)
+    code = make_frame("code", 10)
+
+    first = build_balanced_split(math, code, per_domain_size=4, seed=7, split="train")
+    second = build_balanced_split(math, code, per_domain_size=4, seed=7, split="train")
+
+    assert first == second
+    assert [row["extra_info"]["domain"] for row in first] == ["math", "code"] * 4
+    assert [row["extra_info"]["index"] for row in first] == list(range(8))
+    assert {row["ability"] for row in first} == {"math", "code"}
