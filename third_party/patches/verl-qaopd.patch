+import json
+
+from examples.on_policy_distillation_trainer.prepare_verifiable_code import (
+    build_prompt,
+    normalize_source,
+    prepare_splits,
+    select_test_cases,
+)
+
+
+class FakeTokenizer:
+    def apply_chat_template(self, prompt, **kwargs):
+        assert kwargs["enable_thinking"] is False
+        return prompt[0]["content"].split()
+
+
+def make_row(index, source="apps", difficulty="introductory", words=10, tests=12):
+    return {
+        "source": source,
+        "task_type": "verifiable_code",
+        "in_source_id": str(index),
+        "problem_statement": " ".join([f"word{index}"] * words),
+        "gold_standard_solution": "```python\nprint(input())\n```",
+        "problem_id": f"problem-{index}",
+        "metadata": {"difficulty": difficulty, "problem_url": f"https://example.test/{index}"},
+        "verification_info": {
+            "language": "python",
+            "test_cases": [
+                {"fn_name": None, "input": f"{case}\n", "output": f"{case}\n", "type": "stdin_stdout"}
+                for case in range(tests)
+            ],
+        },
+    }
+
+
+def test_prompt_and_source_match_verl_code_reward_contract():
+    prompt = build_prompt("Add two integers.")
+
+    assert normalize_source("apps") == "apps"
+    assert normalize_source("code_contests") == "codecontests"
+    assert prompt[0]["role"] == "user"
+    assert "exactly one ```python code block" in prompt[0]["content"]
+    assert "standard input" in prompt[0]["content"]
+
+
+def test_test_case_selection_is_deterministic_and_bounded():
+    cases = make_row(0)["verification_info"]["test_cases"]
+
+    first = select_test_cases(cases, max_test_cases=5, seed=7, identity="apps:0")
+    second = select_test_cases(cases, max_test_cases=5, seed=7, identity="apps:0")
+
+    assert first == second
+    assert len(first) == 5
+    assert len({case["input"] for case in first}) == 5
+
+
+def test_prepare_splits_is_disjoint_filters_length_and_caps_tests():
+    rows = [make_row(index) for index in range(8)]
+    rows.append(make_row(100, words=200))
+    rows.append(make_row(0))
+    rows.append(make_row(200, source="code_contests", difficulty="7"))
+
+    train, validation, manifest = prepare_splits(
+        rows=rows,
+        tokenizer=FakeTokenizer(),
+        train_size=5,
+        val_size=2,
+        max_prompt_length=80,
+        max_test_cases=4,
+        seed=123,
+        apps_difficulties={"introductory", "interview"},
+        code_contests_max_difficulty=10,
+    )
+
+    train_ids = {row["extra_info"]["problem_id"] for row in train}
+    validation_ids = {row["extra_info"]["problem_id"] for row in validation}
+    assert not train_ids & validation_ids
+    assert len(train) == 5
+    assert len(validation) == 2
+    assert manifest["filter_counts"]["duplicate_rows"] == 1
+    assert manifest["filter_counts"]["overlong_rows"] == 1
+    assert all(row["extra_info"]["num_tests_kept"] == 4 for row in train + validation)
+    assert all(len(json.loads(row["reward_model"]["ground_truth"])["inputs"]) == 4 for row in train + validation)
