+@register_distillation_loss(DistillationLossSettings(names=["paired_dpo"], use_estimator=True))  # type: ignore[arg-type]
+def compute_paired_dpo(
+    config: ActorConfig,
+    distillation_config: DistillationConfig,
+    model_output,
+    data: TensorDict,
+) -> tuple[torch.Tensor, dict[str, Any]]:
+    """Compute reference-corrected DPO over adjacent fixed trajectory pairs.
+
+    Session 0 is the execution-verified FP response and session 1 is the
+    matched failing QAD response. Sequence log probabilities use the standard
+    DPO sum reduction. The pair loss is copied to both rows so the existing
+    sequence-mean token aggregator produces exactly the mean pair loss.
+    """
+    del config
+    student_log_probs = no_padding_2_padding(model_output["log_probs"], data)
+    response_mask = data["response_mask"]
+    if response_mask.is_nested:
+        response_mask = response_mask.to_padded_tensor(False)
+    response_mask_bool = response_mask.bool()
+    if "ref_log_prob" not in data:
+        raise ValueError(
+            "paired_dpo requires a frozen reference policy; set actor_rollout_ref.actor.use_kl_loss=True"
+        )
+    ref_log_probs = data["ref_log_prob"]
+    if ref_log_probs.is_nested:
+        ref_log_probs = ref_log_probs.to_padded_tensor(0.0)
+    assert student_log_probs.shape == ref_log_probs.shape == response_mask_bool.shape
+    _paired_session_ids(data, device=student_log_probs.device)
+
+    mask = response_mask_bool.to(student_log_probs.dtype)
+    policy_sequence_logps = (student_log_probs * mask).sum(dim=-1)
+    reference_sequence_logps = (ref_log_probs * mask).sum(dim=-1)
+    policy_logratios = policy_sequence_logps[0::2] - policy_sequence_logps[1::2]
+    reference_logratios = reference_sequence_logps[0::2] - reference_sequence_logps[1::2]
+    preference_logits = distillation_config.distillation_loss.preference_beta * (
+        policy_logratios - reference_logratios
+    )
+    pair_losses = -F.logsigmoid(preference_logits)
+
+    per_sequence_losses = pair_losses.repeat_interleave(2)
+    token_losses = per_sequence_losses.unsqueeze(-1).expand_as(student_log_probs)
+    metrics = {
+        "distillation/dpo_pair_loss": Metric(AggregationType.MEAN, pair_losses.mean()),
+        "distillation/dpo_margin": Metric(AggregationType.MEAN, preference_logits.mean()),
+        "distillation/dpo_preference_accuracy": Metric(
+            AggregationType.MEAN, (preference_logits > 0).float().mean()
+        ),
+        "distillation/dpo_policy_logratio": Metric(AggregationType.MEAN, policy_logratios.mean()),
+        "distillation/dpo_reference_logratio": Metric(AggregationType.MEAN, reference_logratios.mean()),
+    }
+    return token_losses, metrics
+
