+import json
+from pathlib import Path
+
+from jinja2 import Environment
+
+from examples.on_policy_distillation_trainer.prepare_kodcode_humaneval import (
+    extract_pytest_programs,
+    prepare_source_row,
+)
+from examples.on_policy_distillation_trainer.prepare_mbpp_humaneval import ASSISTANT_PREFIX
+
+
+class _Tokenizer:
+    def apply_chat_template(self, messages, *, add_generation_prompt, tokenize, **kwargs):
+        if tokenize:
+            return list(range(32))
+        if add_generation_prompt:
+            return "rendered prompt"
+        return "rendered prompt" + messages[-1]["content"]
+
+    def __call__(self, text, add_special_tokens=False):
+        return {"input_ids": list(range(len(text.split())))}
+
+
+def _source_row() -> dict:
+    return {
+        "style": "instruct",
+        "subset": "Leetcode",
+        "question_id": "Leetcode_test_I",
+        "question": "Return the sum of two integers.",
+        "solution": "def add_numbers(left, right):\n    return left + right\n",
+        "test_code": (
+            "from solution import add_numbers\n\n"
+            "def test_positive():\n    assert add_numbers(2, 3) == 5\n\n"
+            "def test_negative():\n    assert add_numbers(-2, 1) == -1\n"
+        ),
+        "test_info": [
+            {
+                "docstring": "Return a sum.",
+                "function_declaration": "def add_numbers(left, right):",
+                "function_name": "add_numbers",
+                "parameter_list": "(left, right)",
+            }
+        ],
+        "gpt_difficulty": "easy",
+    }
+
+
+def test_extract_pytest_programs_runs_test_functions_explicitly():
+    setup, tests = extract_pytest_programs(_source_row()["test_code"], "add_numbers")
+
+    assert setup == ""
+    assert len(tests) == 2
+    assert tests[0].endswith("test_positive()")
+
+
+def test_prepare_source_row_builds_verified_humaneval_protocol():
+    row = prepare_source_row(
+        _source_row(),
+        source_index=7,
+        tokenizer=_Tokenizer(),
+        chat_template="unused",
+        humaneval_descriptions=[],
+        contamination_threshold=0.3,
+        max_prompt_length=128,
+        max_response_length=128,
+        teacher_forcing=True,
+    )
+
+    assert row["task_id"] == 2_000_007
+    assert row["data_source"] == "kodcode_humaneval"
+    assert row["agent_name"] == "teacher_forcing_agent"
+    assert "add_numbers" in row["extra_info"]["answer"]
+    ground_truth = json.loads(row["reward_model"]["ground_truth"])
+    assert ground_truth["function_name"] == "add_numbers"
+    assert len(ground_truth["tests"]) == 2
+
+
+def test_chat_template_keeps_nested_markdown_fences_inside_stub():
+    template_path = (
+        Path(__file__).parents[3] / "examples/on_policy_distillation_trainer/humaneval_opd_chat_template.jinja"
+    )
+    template = Environment().from_string(template_path.read_text(encoding="utf-8"))
+    function_stub = (
+        "def add_numbers(left, right):\n"
+        "    \"\"\"Example:\n"
+        "    ```python\n"
+        "    add_numbers(2, 3)\n"
+        "    ```\n"
+        "    \"\"\"\n\n"
+    )
+    prompt = [{"role": "user", "content": f"Solve this:\n```python\n{function_stub}```\n"}]
+    answer = f"{ASSISTANT_PREFIX}{function_stub}    return left + right\n```\n"
+
+    generation_prompt = template.render(messages=prompt, add_generation_prompt=True)
+    full_conversation = template.render(
+        messages=[*prompt, {"role": "assistant", "content": answer}],
+        add_generation_prompt=False,
+    )
+
+    assert generation_prompt.endswith(function_stub)
+    assert full_conversation.startswith(generation_prompt)
