@@ -0,0 +1,78 @@
+"""EdgeRazor W/A quantization adapters for FSDP training and vLLM rollout."""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any
+
+import torch.nn as nn
+
+logger = logging.getLogger(__name__)
+
+
+def _require_edgerazor():
+    try:
+        import edgerazor
+    except ImportError as exc:
+        raise ImportError(
+            "EdgeRazor is required for qat.backend=edgerazor. Add "
+            "<EdgeRazor>/src to PYTHONPATH; installing into the verl environment is not required."
+        ) from exc
+    return edgerazor
+
+
+def apply_edgerazor_qat(model: nn.Module, config_path: str) -> nn.Module:
+    """Apply EdgeRazor fake W/A quantization while retaining latent parameters."""
+    if not config_path:
+        raise ValueError("qat.edgerazor_config_path is required for the EdgeRazor backend")
+    path = Path(config_path)
+    if not path.is_file():
+        raise FileNotFoundError(f"EdgeRazor QAT config does not exist: {path}")
+
+    edgerazor = _require_edgerazor()
+    qat = edgerazor.QAT(path)
+    model = qat.quantize(model)
+
+    from edgerazor.qat import QEmbedding, QLinear
+
+    linear_count = sum(isinstance(module, QLinear) for module in model.modules())
+    embedding_count = sum(isinstance(module, QEmbedding) for module in model.modules())
+    if linear_count == 0:
+        raise RuntimeError("EdgeRazor selected no Linear modules for QAT")
+    logger.info(
+        "Applied EdgeRazor QAT: %d Linear modules and %d Embedding modules",
+        linear_count,
+        embedding_count,
+    )
+    return model
+
+
+def build_vllm_quantization_config(qat_config: Any) -> dict[str, Any]:
+    """Build the standard HF quantization_config consumed by vLLM 0.11."""
+    quant_mode = getattr(qat_config, "edgerazor_quant_mode", None)
+    if not quant_mode:
+        raise ValueError("qat.edgerazor_quant_mode is required for EdgeRazor vLLM rollout")
+
+    _require_edgerazor()
+    from edgerazor.vllm.quant_mode_parse import QuantModeConfig
+
+    parsed = QuantModeConfig(quant_mode)
+    return {
+        "quant_method": "edgerazor",
+        "quant_mode": quant_mode,
+        "weight_bits": parsed.weight_bits,
+        "activation_bits": parsed.activation_bits,
+        # EdgeRazor's vLLM plugin currently leaves the real KV cache unquantized.
+        "kv_cache_bits": 16,
+        "backend": "py",
+    }
+
+
+def register_vllm_plugin() -> None:
+    """Register the source-tree plugin without modifying the conda environment."""
+    _require_edgerazor()
+    from edgerazor.vllm import register
+
+    if not register():
+        raise RuntimeError("Failed to register the EdgeRazor vLLM quantization plugin")
