+import json
+
+import pytest
+
+from examples.on_policy_distillation_trainer.code_execution_reward import compute_score
+
+TESTS = json.dumps({"inputs": ["1 2\n", "2 2\n"], "outputs": ["3\n", "4\n"]})
+
+
+def test_execution_reward_scores_pass_partial_and_wrong_programs():
+    passing = "```python\na, b = map(int, input().split())\nprint(a + b)\n```"
+    partial = "```python\na, b = map(int, input().split())\nprint(3)\n```"
+    wrong = "```python\na, b = map(int, input().split())\nprint(a - b)\n```"
+
+    assert compute_score("apps", passing, TESTS) == 1.0
+    assert compute_score("apps", partial, TESTS) == pytest.approx(0.55)
+    assert compute_score("apps", wrong, TESTS) == pytest.approx(0.1)
+
+
+def test_execution_reward_normalizes_output_whitespace():
+    solution = "```python\nprint('1  2')\n```"
+    tests = json.dumps({"inputs": [""], "outputs": ["1 2   \n"]})
+    assert compute_score("codecontests", solution, tests) == 1.0
+
+
+def test_execution_reward_rejects_malformed_or_unsafe_programs():
+    assert compute_score("apps", "print(3)", TESTS) == 0.0
+    assert compute_score("apps", "```python\nimport os\nprint(3)\n```", TESTS) == 0.0
+    assert compute_score("apps", "```python\nopen('/tmp/x', 'w')\n```", TESTS) == 0.0
+    assert compute_score("other", "```python\nprint(3)\n```", TESTS) == 0.0
+
