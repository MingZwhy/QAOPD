+    """Compute reverse KL on the intersection of student and teacher top-k sets.
+
+    The two distributions are renormalized on their shared support before
+    computing KL(student || teacher). Positions with no shared token contribute
+    zero loss. This follows the overlap-only OPD ablation in arXiv:2604.13016.
+    """
+    del data_format
+    assert teacher_topk_log_probs.is_nested and teacher_topk_ids.is_nested
