+import pytest
+import torch
+
+from examples.on_policy_distillation_trainer.rank_verified_replay_by_teacher import (
+    rank_scored_rows,
+    response_logprob_stats,
+)
+
+
+def _row(task_id: int, output_hash: str, mean_logprob: float, tokens: int, answer: str) -> dict:
+    return {
+        "task_id": task_id,
+        "extra_info": {
+            "answer": answer,
+            "replay_output_sha256": output_hash,
+            "teacher_mean_logprob": mean_logprob,
+            "teacher_response_tokens": tokens,
+        },
+    }
+
+
+def test_response_logprob_stats_scores_only_response_targets():
+    input_ids = torch.tensor([[0, 1, 2, 0], [1, 2, 0, 0]])
+    logits = torch.zeros(2, 4, 3)
+    logits[0, 1, 2] = 2.0
+    logits[0, 2, 0] = 1.0
+    logits[1, 0, 2] = 3.0
+
+    totals, means = response_logprob_stats(logits, input_ids, [2, 1], [2, 1])
+
+    expected_first = torch.log_softmax(logits[0, 1:3], dim=-1)[torch.arange(2), torch.tensor([2, 0])].sum()
+    expected_second = torch.log_softmax(logits[1, 0], dim=-1)[2]
+    assert totals == pytest.approx([expected_first.item(), expected_second.item()], rel=2e-6)
+    assert means == pytest.approx([expected_first.item() / 2, expected_second.item()], rel=2e-6)
+
+
+def test_rank_scored_rows_prefers_teacher_compatible_success_over_shortest():
+    rows = [
+        _row(1, "short", -1.5, 4, "x"),
+        _row(1, "compatible", -0.2, 8, "a longer answer"),
+        _row(2, "tie-long", -0.4, 9, "a much longer answer"),
+        _row(2, "tie-short", -0.4, 5, "x"),
+    ]
+
+    selected, stats = rank_scored_rows(rows, max_per_task=1)
+
+    assert [row["extra_info"]["replay_output_sha256"] for row in selected] == ["compatible", "tie-short"]
+    assert stats["tasks_changed_from_shortest"] == 1
+    assert all(row["extra_info"]["teacher_rank_within_task"] == 0 for row in selected)
